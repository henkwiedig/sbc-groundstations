+br-rockchip: version.h
+	$(eval SDK = ./sdk/gk7205v300)
+	$(eval CFLAGS += -D__ROCKCHIP__)
+	$(eval LIB = `pkg-config --libs cairo` -lm -lrt -lsqlite3)
