#!/bin/sh
#
# ascent-ota: updates the Caddx Ascent air unit's OpenIPC firmware over the
# AR8030 link (ar_net0), from an ASW image on this ground station -- builder's
# Ascent_H_Sky_*_OpenIPC*.img (devices/hi3516cv6xx_artosyn_caddx-ascent-lite).
#
# Serves the image over HTTP on the ground's ar_net0 address while it runs
# and lets the air's own sysupgrade fetch it (--asw=<url>). That script owns
# the A/B flashing: it writes the inactive bank, verifies it and only then
# switches the boot bank, so a failed update leaves the air on its old bank.
# --copy-overlay gives the new bank this bank's settings, the AR8030 pairing
# among them -- with the image's blank usrdata the new bank would boot
# unpaired and never come back over this link.
#
# Without python3 (the VR04 image has none), or with OTA_TRANSPORT=ssh, the
# image goes into the air's /tmp over ssh instead and sysupgrade takes that
# file. The air holds the whole image in /tmp either way: its sysupgrade
# downloads an URL there too. dropbear's 24 KiB receive window makes the ssh
# copy ~30 % slower than HTTP.
#
# The uplink is the slow direction: the air holds it at MCS 1-2 (stock's
# link policy, lifecycled --link-policy 2) inside the frame structure
# lifecycled exchanges in the downlink's favour, ~1.1 Mbit/s of TCP. For
# the download the air goes to the original frame structure and MCS 1-8,
# 4.2 Mbit/s of TCP on the bench (P1 air) at 20 MHz, or MCS 1-5, ~3.1
# Mbit/s, on an air whose chip can't take more (BOOST_MCS8 below). The air
# reverts on its own after OTA_BOOST_SECS should this script die, and a
# reboot starts from lifecycled's defaults anyway.

AIR=${AIR_IP:-192.168.100.1}
GND=${GND_IP:-192.168.100.2}
PORT=${OTA_HTTP_PORT:-8000}
AIR_SSH_PASS=${AIR_SSH_PASS:-12345}
BOOST_SECS=${OTA_BOOST_SECS:-900}

BOOST_ON="ar8030-linkctl frame-change 0 && ar8030-linkctl mcs-range 1 5"
# MCS 8 needs the air chip's rx buffers sized for it. The chip sizes them at
# boot by the largest rx half of its config, and builder's air config has the
# broadcast rx half at 10 MHz for that (builder package/ar8030 README). Under
# the earlier 5 MHz an uplink block above MCS 5 overflows them ("rx len 3070
# exceeding!") and the uplink collapses, so the boost asks the chip first:
# user 8's rx bandwidth in linkctl status. The air takes MCS table entry 8
# (7, 10 and 12 it refuses with ret=6).
BOOST_MCS8="ar8030-linkctl frame-change 0 && ar8030-linkctl mcs-table 2 8 && ar8030-linkctl mcs-range 1 8"
BOOST_MCS8_IF='^user 8: .* rx\{[^}]*bandwidth=(10|20|40)M'
BOOST_OFF="ar8030-linkctl mcs-range 1 2; ar8030-linkctl frame-change 1"
BOOST_PID=/tmp/ascent-ota-boost.pid
PROGRESS=/tmp/ascent-ota.progress
D=/tmp/ascent-ota # on the air, for the ssh copy
CHUNK=1048576

usage() {
	cat <<EOF
Usage: $0 [options] <image.img>

Flashes the air unit's inactive bank with <image.img> (an ASW image) over
ar_net0, carries its settings and pairing over, and reboots it into the
new bank.

  -x, --no-reboot      Flash and select the new bank, don't reboot.
  --no-boost           Leave the uplink at its normal MCS/frame setup.
  --sysupgrade=FILE    Run FILE on the air instead of its own
                       /usr/sbin/sysupgrade (an air build older than
                       --copy-overlay: pass builder's sysupgrade).

Environment: AIR_IP ($AIR), GND_IP ($GND), OTA_HTTP_PORT ($PORT),
AIR_SSH_PASS, OTA_BOOST_SECS ($BOOST_SECS), OTA_TRANSPORT (http with
python3 here, else ssh).
EOF
}

die() {
	echo "ascent-ota: $*" >&2
	exit 1
}

connect=10 # ssh connect timeout, short while the air reboots
air() {
	sshpass -p "$AIR_SSH_PASS" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
		-o LogLevel=ERROR -o ConnectTimeout=$connect -o ServerAliveInterval=5 -o ServerAliveCountMax=6 \
		"root@$AIR" "$@"
}

no_reboot=
boost=1
sysupgrade_file=
img=
for i in "$@"; do
	case "$i" in
		-h | --help) usage; exit 0 ;;
		-x | --no-reboot) no_reboot=1 ;;
		--no-boost) boost= ;;
		--sysupgrade=*) sysupgrade_file="${i#*=}" ;;
		-*) usage; exit 1 ;;
		*) img=$i ;;
	esac
done
[ -n "$img" ] || { usage; exit 1; }
[ -f "$img" ] || die "$img: no such file"
[ "$(head -c 4 "$img" | od -An -tx1 | tr -d ' \n')" = 41535700 ] || die "$img is not an ASW image"
[ -z "$sysupgrade_file" ] || [ -f "$sysupgrade_file" ] || die "$sysupgrade_file: no such file"

case "${OTA_TRANSPORT:-auto}" in
	http) http=1 ;;
	ssh) http= ;;
	auto) http=; command -v python3 >/dev/null 2>&1 && http=1 ;;
	*) die "OTA_TRANSPORT must be http or ssh" ;;
esac
size=$(wc -c < "$img") # no stat in the VR04 image

work=$(mktemp -d /tmp/ascent-ota.XXXXXX) || die "mktemp failed"
http_pid=
boosted=
air_rm=
cleanup() {
	[ -n "$http_pid" ] && kill "$http_pid" 2>/dev/null
	[ -n "$boosted" ] && boost_off
	[ -n "$air_rm" ] && air "rm -rf $D" >/dev/null 2>&1
	rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 1' INT TERM HUP

boost_off() {
	air "[ -f $BOOST_PID ] && kill \$(cat $BOOST_PID) 2>/dev/null; rm -f $BOOST_PID; $BOOST_OFF" >/dev/null 2>&1 ||
		echo "ascent-ota: could not restore the uplink; the air does it itself within ${BOOST_SECS}s" >&2
	boosted=
}

# Which bank (0/1) the air runs, the way its sysupgrade tells (the mtd behind ubi0).
air_bank() {
	air 'grep "^mtd$(cat /sys/class/ubi/ubi0/mtd_num):" /proc/mtd' 2>/dev/null |
		sed -n 's/.*"rootfs\([01]\)".*/\1/p'
}

echo "Air: $AIR"
bank=$(air_bank)
[ -n "$bank" ] || die "no ssh to root@$AIR, or it isn't an A/B Ascent air unit (link up? AIR_SSH_PASS?)"
air '. /etc/os-release; echo "  running bank '"$bank"': $GITHUB_VERSION $BUILD_ID"'

sysupgrade=/usr/sbin/sysupgrade
if [ -n "$sysupgrade_file" ]; then
	sysupgrade=/tmp/ascent-ota-sysupgrade
	air "cat > $sysupgrade && chmod +x $sysupgrade" <"$sysupgrade_file" || die "copying $sysupgrade_file to the air failed"
fi
air "$sysupgrade --help" 2>/dev/null | grep -q -- --copy-overlay ||
	die "the air's sysupgrade has no --copy-overlay, so the new bank would boot unpaired.
Flash a newer build once by USB, or pass --sysupgrade=<builder's sysupgrade>."

if [ -n "$http" ]; then
	# Served from a directory holding nothing but the image.
	name=$(basename "$img" | tr -c 'A-Za-z0-9._\n-' _)
	ln -s "$(realpath "$img")" "$work/$name"
	python3 -m http.server "$PORT" --bind "$GND" --directory "$work" >/dev/null 2>&1 &
	http_pid=$!
	url="http://$GND:$PORT/$name"
	i=0
	until curl -sfI -m 2 "$url" >/dev/null; do
		i=$((i + 1))
		[ $i -lt 10 ] && kill -0 "$http_pid" 2>/dev/null || die "HTTP server on $GND:$PORT did not come up"
		sleep 0.5
	done
else
	free=$(air "df -k /tmp | awk 'NR == 2 { print \$4 }'")
	[ "$free" -gt $((size / 1024 + 1024)) ] 2>/dev/null ||
		die "the image needs $((size / 1024)) KiB in the air's /tmp, it has ${free:-?} KiB free"
	air "rm -rf $D && mkdir $D" || die "cannot create $D on the air"
	air_rm=1
fi

if [ -n "$boost" ]; then
	mcs=5
	air "ar8030-linkctl status 2>/dev/null" | grep -Eq "$BOOST_MCS8_IF" && { BOOST_ON=$BOOST_MCS8; mcs=8; }
	if air "{ $BOOST_ON; } >/dev/null 2>&1 && { setsid sh -c 'sleep $BOOST_SECS; $BOOST_OFF' </dev/null >/dev/null 2>&1 & echo \$! > $BOOST_PID; }"; then
		echo "  uplink boost: MCS 1-$mcs"
	else
		echo "ascent-ota: uplink boost failed, copying at the normal rate" >&2
	fi
	boosted=1
fi

if [ -n "$http" ]; then
	echo "Image: $url ($((size / 1024)) KiB)"
	asw=$url
else
	chunks=$(((size + CHUNK - 1) / CHUNK))
	echo "Copying $(basename "$img") ($((size / 1024)) KiB) to the air"
	t0=$(date +%s)
	i=0
	while [ $i -lt $chunks ]; do
		dd if="$img" bs=$CHUNK skip=$i count=1 2>/dev/null || exit 1
		i=$((i + 1))
		printf '\r  %d/%d MiB' $i $chunks >&2
	done | air "cat > $D/image.img" || { echo >&2; die "copying the image failed"; }
	secs=$(($(date +%s) - t0))
	[ $secs -gt 0 ] || secs=1
	echo "  in ${secs}s ($((size / 1024 / secs)) KiB/s)" >&2
	[ "$(air "wc -c < $D/image.img")" -eq "$size" ] 2>/dev/null || die "the copy on the air is incomplete"
	[ -n "$boosted" ] && boost_off
	asw=$D/image.img
	air_rm= # sysupgrade reads it until it is done
fi
air "rm -f $PROGRESS; SYSUPGRADE_PROGRESS=$PROGRESS $sysupgrade --asw=$asw --copy-overlay -x"
rc=$?

# sysupgrade keeps going if the session drops once it is flashing; ask how it ended.
if [ $rc -eq 255 ]; then
	echo "ascent-ota: lost the session; waiting for the air's sysupgrade to finish" >&2
	rc=1
	i=0
	while [ $i -lt 60 ]; do
		case "$(air "tail -n 1 $PROGRESS" 2>/dev/null)" in
			done) rc=0; break ;;
			failed) break ;;
		esac
		i=$((i + 1))
		sleep 5
	done
fi
[ -n "$boosted" ] && boost_off
kill "$http_pid" 2>/dev/null
http_pid=
[ $rc -eq 0 ] || die "sysupgrade failed (see above); the air stays on bank $bank"
[ -n "$http" ] || air_rm=1 # flashed: the copy on the air can go

new_bank=$((1 - bank))
if [ -n "$no_reboot" ]; then
	echo "Bank $new_bank flashed and selected; reboot the air to start it."
	exit 0
fi

# Back is when the air answers with another boot id: right after the reboot
# command the old system may still answer for a moment.
boot_id=$(air 'cat /proc/sys/kernel/random/boot_id' 2>/dev/null)
echo "Rebooting the air into bank $new_bank"
air_rm= # the reboot clears /tmp
air 'busybox reboot -d 1 -f' >/dev/null 2>&1
sleep 3
connect=3
deadline=$(($(date +%s) + 180))
until b=$(air 'cat /proc/sys/kernel/random/boot_id' 2>/dev/null) && [ -n "$b" ] && [ "$b" != "$boot_id" ]; do
	[ "$(date +%s)" -lt $deadline ] ||
		die "the air is not back after 3 minutes (unpaired? stuck booting bank $new_bank?) -- check it over USB"
	sleep 2
done
connect=10
now=$(air_bank)
[ "$now" = "$new_bank" ] || die "the air came back on bank $now, not $new_bank"
air '. /etc/os-release; echo "Air back on bank '"$now"': $GITHUB_VERSION $BUILD_ID"'
