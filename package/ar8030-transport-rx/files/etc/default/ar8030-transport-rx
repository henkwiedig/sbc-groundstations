# ar8030-transport-rx runtime configuration, sourced by
# /etc/init.d/S98ar8030-transport-rx.

# AR8030_TRANSPORT_RX_ENABLED=false

# Extra flags passed straight to ar8030-transport-rx -- see its -h output
# (ar8030-transport's README "Build" / rx/main.c usage()) for the full
# list. Example overriding the bb_socket port and PixelPilot target:
#   AR8030_TRANSPORT_RX_ARGS="-o 2 -H 127.0.0.1 -p 5600"
AR8030_TRANSPORT_RX_ARGS=""

# Extra flags passed straight to ar8030-lifecycled -- see its --help
# output (ar8030-transport's README "HTTP control API" / lifecycled/
# main.c usage()) for the full list. Empty by default. Example enabling
# its HTTP control API on this ground unit:
#   AR8030_LIFECYCLED_ARGS="--http-port 8899"
# --link-policy 2: on every connect push stock's downlink MCS table for
# video_strategy 2 (~2.5-3 dB lower thresholds than ar8030.json's), as
# the stock goggles do for the Ascent Lite. See ar8030-transport
# common/ar8030_link_policy.h.
AR8030_LIFECYCLED_ARGS="--http-port 8899 --link-policy 2"

# ar8030-flightlog (/etc/init.d/S99ar8030-flightlog, toggle with `flightlog
# enable|disable`): records link quality
# (both sides' lifecycled HTTP API above, so it needs --http-port 8899
# here and on the air unit), the air unit's forwarded syslog and this
# unit's syslog to $FLIGHTLOG_DIR, one session directory per boot. See
# /usr/bin/ar8030-flightlog for the file formats and the other knobs.
FLIGHTLOG_ENABLED=false
#FLIGHTLOG_DIR=/media/dvr/flightlog
#FLIGHTLOG_INTERVAL=0.5
#FLIGHTLOG_KEEP=30
