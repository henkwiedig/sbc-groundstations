+static void mac_to_hex(const bb_mac_t* mac, char* out /* needs 2*BB_MAC_LEN+1 bytes */)
+{
+    for (int i = 0; i < BB_MAC_LEN; i++) {
+        sprintf(out + i * 2, "%02x", mac->addr[i]);
+    }
+}
+
+// The dispatch in _pair_thread_run runs synchronously (asyn=0) and only
+// returns once the chip's own pairing dance has finished or timed out, so
+// by the time AR8030Helper_startPair's wait loop exits, a successful pair
+// should already show up here -- this loop is just a short-timeout safety
+// margin for that state to propagate, not a re-implementation of pairing.
+// Reuses the exact same "is this slot real" check as ar8030-status (see
+// package/ar8030/files/ar8030-status.c): state must be a valid
+// bb_link_state_e and the peer MAC non-zero.
+static int wait_for_paired_peer(bb_dev_handle_t* bb_handle, int timeout_s, uint8_t* out_role, bb_mac_t* out_mac)
+{
+    for (int elapsed = 0; elapsed < timeout_s; elapsed++) {
+        bb_get_status_in_t  in  = { 0xffff };
+        bb_get_status_out_t out;
+        memset(&out, 0, sizeof(out));
+        if (bb_ioctl(bb_handle, BB_GET_STATUS, &in, &out) == 0) {
+            *out_role = out.role;
+            for (int s = 0; s < BB_SLOT_MAX; s++) {
+                bb_link_status_t* ls = &out.link_status[s];
+                if (ls->state != BB_LINK_STATE_CONNECT) {
+                    continue;
+                }
+                bool mac_zero = true;
+                for (int b = 0; b < BB_MAC_LEN; b++) {
+                    if (ls->peer_mac.addr[b]) {
+                        mac_zero = false;
+                        break;
+                    }
+                }
+                if (!mac_zero) {
+                    *out_mac = ls->peer_mac;
+                    return s;
+                }
+            }
+        }
+        sleep(1);
+    }
+    return -1;
+}
+
+// Writes the paired peer's MAC into the on-disk config so it survives the
+// next boot's firmware push. Mirrors upstream's own (unused, see
+// dev_helper/bb_pair/bb_pair.cpp) reference split: an AP keeps a candidate
+// allowlist per slot (baseband.basic.ap.candidate.slot, or .slotN when the
+// file already uses the multi-slot form -- see usr_master.json/
+// usr_slave.json/bb_config_director.json for that shape), a DEV just points
+// at one AP MAC (baseband.basic.dev.ap_mac). Returns 0 on success.
+static int persist_paired_peer(const char* cfg_path, int slot, uint8_t role, const char* mac_hex)
 {
+    FILE* f = fopen(cfg_path, "rb");
+    if (!f) {
+        printf("persist: can't open %s for reading: %s\n", cfg_path, strerror(errno));
+        return -1;
+    }
+    fseek(f, 0, SEEK_END);
+    long len = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    char* buf = (char*)malloc(len + 1);
+    if (!buf || fread(buf, 1, len, f) != (size_t)len) {
+        printf("persist: read of %s failed\n", cfg_path);
+        fclose(f);
+        free(buf);
+        return -1;
+    }
+    buf[len] = 0;
+    fclose(f);
+
+    cJSON* root = cJSON_Parse(buf);
+    free(buf);
+    if (!root) {
+        printf("persist: %s is not valid JSON\n", cfg_path);
+        return -1;
+    }
+
+    int ret = -1;
+    cJSON* baseband = cJSON_GetObjectItem(root, "baseband");
+    cJSON* basic = baseband ? cJSON_GetObjectItem(baseband, "basic") : NULL;
+    cJSON* section = basic ? cJSON_GetObjectItem(basic, role == BB_ROLE_AP ? "ap" : "dev") : NULL;
+    if (!section) {
+        printf("persist: %s has no baseband.basic.%s section\n", cfg_path, role == BB_ROLE_AP ? "ap" : "dev");
+        cJSON_Delete(root);
+        return -1;
+    }
+
+    if (role == BB_ROLE_AP) {
+        cJSON* candidate = cJSON_GetObjectItem(section, "candidate");
+        if (!candidate) {
+            candidate = cJSON_AddObjectToObject(section, "candidate");
+        }
+        // cJSON_ReplaceItemViaPointer only splices the linked list -- it does
+        // NOT copy the object key onto the replacement, so it has to be
+        // cJSON_ReplaceItemInObject (which strdup()s the key itself) instead,
+        // or the entry silently loses its "slot"/"slotN" key on the very
+        // first pair.
+        char slot_key[8];
+        snprintf(slot_key, sizeof(slot_key), "slot%d", slot);
+        const char* key = cJSON_GetObjectItem(candidate, "slot") ? "slot" : slot_key;
+
+        cJSON* new_arr = cJSON_CreateArray();
+        cJSON_AddItemToArray(new_arr, cJSON_CreateString(mac_hex));
+        if (cJSON_GetObjectItem(candidate, key)) {
+            cJSON_ReplaceItemInObject(candidate, key, new_arr);
+        } else {
+            cJSON_AddItemToObject(candidate, key, new_arr);
+        }
+    } else {
+        cJSON* apmac_str = cJSON_CreateString(mac_hex);
+        if (cJSON_GetObjectItem(section, "ap_mac")) {
+            cJSON_ReplaceItemInObject(section, "ap_mac", apmac_str);
+        } else {
+            cJSON_AddItemToObject(section, "ap_mac", apmac_str);
+        }
+    }
+
+    char* text = cJSON_Print(root);
+    if (!text) {
+        printf("persist: failed to serialize updated config\n");
+        cJSON_Delete(root);
+        return -1;
+    }
+    char tmp_path[512];
+    snprintf(tmp_path, sizeof(tmp_path), "%s.tmp", cfg_path);
+    FILE* wf = fopen(tmp_path, "wb");
+    if (!wf) {
+        printf("persist: can't open %s for writing: %s\n", tmp_path, strerror(errno));
+        free(text);
+        cJSON_Delete(root);
+        return -1;
+    }
+    fwrite(text, 1, strlen(text), wf);
+    fclose(wf);
+    free(text);
+    if (rename(tmp_path, cfg_path) == 0) {
+        ret = 0;
+    } else {
+        printf("persist: rename %s -> %s failed: %s\n", tmp_path, cfg_path, strerror(errno));
+    }
+
+    cJSON_Delete(root);
+    return ret;
+}
