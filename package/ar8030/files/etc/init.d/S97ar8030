#!/bin/sh
#
# Starts the Artosyn AR8030 baseband/RF link.
#
# ar8030-lifecycled (see OpenIPC/builder's own ar8030-transport-tx S65
# script for the fuller story of why a dedicated process replaces shell
# watchdogs) owns pairing, reconnect-on-drop, link-state tracking,
# tuning, and hook-script dispatch here too -- but NOT hardware reset
# (--reset-method none, unlike air's --reset-method devmem): this
# board's chip goes through a one-time boot-ROM firmware push over USB
# (enable_rf() -> modprobe -> wait for /dev/ar_mdev0 -> rmmod, below),
# not a "module stays loaded, chip can be re-pulsed anytime" model like
# air's SDIO transport. ar8030-lifecycled only starts once that whole
# dance is already done and the daemon is talking to the chip directly
# over USB; pulsing enable_rf()'s GPIOs again at that point would reset
# a chip already running its real firmware, right as the daemon expects
# to keep talking to it -- so enable_rf() stays exactly where it is,
# not folded into ar8030-lifecycled's own reset backends.
#
# Deliberately not yet done, matching air-side ar8030-lifecycled's own
# scope: tying ar8030-transport-rx's own start/stop to hook dispatch
# (see BR2_PACKAGE_AR8030_LIFECYCLED's Config.in help) -- rx already
# tolerates no link on its own (see its own S98 script's header
# comment), and air's own tx/hook wiring hasn't finished a full clean
# validation pass yet, so bringing that same pattern here too is left
# for its own dedicated verification.

# Allow a few customizations from a config file
test -r /etc/default/ar8030 && . /etc/default/ar8030

BB_FW=${BB_FW:-ar8030/bb_demo_cx485_2PA.img}
BB_CFG=${BB_CFG:-ar8030/bb_config_gnd_pro.json}

LIFECYCLED="/usr/bin/ar8030-lifecycled"
LIFECYCLED_PIDFILE="/var/run/ar8030-lifecycled.pid"

# Both ar8030d (DAEMON_LOG_PATH, "daemon_log") and ar8030-lifecycled
# (AR8030_LIFECYCLED_LOG_PATH, "lifecycle_log") write their own logs
# under a directory *relative to their current working directory* --
# neither takes a log-path flag. This script never cd'd anywhere before
# starting either one, so both landed wherever rcS happened to invoke
# this script from (confirmed live: /root, and even bare / from some
# earlier boot) instead of somewhere predictable. cd into a fixed rundir
# before starting each, matching OpenIPC/builder's own S65
# ar8030-transport-tx script.
RUNDIR="/tmp/ar8030"

if [ x$AR8030_ENABLED = x"false" ]; then
	echo "Starting ar8030... skipped (disabled)"
	exit 0
fi

# Power-on handshake for the AR8030 RF daughterboard, ported verbatim
# (GPIO numbers, ordering, delays) from stock's S99ar8030 enable_rf().
# Not modeled in the shared devicetree -- stock drives these as raw sysfs
# GPIOs too. gpio154=bank4/offset26, gpio83/84/82=bank2/offset19/20/18.
enable_rf() {
	echo 154 > /sys/class/gpio/export
	echo out > /sys/class/gpio/gpio154/direction
	echo 0 > /sys/class/gpio/gpio154/value

	echo 83 > /sys/class/gpio/export
	echo out > /sys/class/gpio/gpio83/direction
	echo 0 > /sys/class/gpio/gpio83/value

	echo 84 > /sys/class/gpio/export
	echo out > /sys/class/gpio/gpio84/direction
	echo 0 > /sys/class/gpio/gpio84/value

	echo 82 > /sys/class/gpio/export
	echo out > /sys/class/gpio/gpio82/direction
	echo 0 > /sys/class/gpio/gpio82/value

	usleep 100000

	echo 1 > /sys/class/gpio/gpio83/value
	echo 1 > /sys/class/gpio/gpio84/value

	usleep 50000

	echo 1 > /sys/class/gpio/gpio154/value

	usleep 50000

	echo 1 > /sys/class/gpio/gpio82/value

	usleep 280000

	echo in > /sys/class/gpio/gpio84/direction
	echo in > /sys/class/gpio/gpio83/direction
	echo in > /sys/class/gpio/gpio82/direction
}

# Waits (up to $2 seconds) for $1 to appear. Used the same way stock uses
# it: /dev/ar_mdev0 is artosyn_drv.ko's signal that firmware+config were
# successfully pushed to the chip over USB.
wait_flag_file() {
	flag_file="$1"
	max_timeout="$2"
	timeout_count=0

	while true; do
		[ -e "$flag_file" ] && return 0
		sleep 1
		timeout_count=$((timeout_count + 1))
		[ "$timeout_count" -ge "$max_timeout" ] && return 1
	done
}

start_lifecycled() {
	[ -x "$LIFECYCLED" ] || return 0
	mkdir -p "$RUNDIR"
	cd "$RUNDIR" || return 1
	start-stop-daemon -S -q -b -m -p "$LIFECYCLED_PIDFILE" -x "$LIFECYCLED" -- \
		--role dev \
		--reset-method none \
		--hook-dir /etc/ar8030/hooks.d \
		--cfg-path "/lib/firmware/$BB_CFG" \
		--default-bandwidth 20
}

start() {
	printf "Starting ar8030... "

	enable_rf

	modprobe artosyn_drv fw_name="$BB_FW" cfg_name="$BB_CFG"

	if ! wait_flag_file /dev/ar_mdev0 30; then
		echo "FAIL (firmware/config push timed out)"
		return 1
	fi

	# artosyn_drv.ko's only job is pushing firmware+config over USB while
	# the chip is in its boot-ROM stage (see /dev/ar_mdev0 above, used
	# purely as the "push done" signal). Once the chip reboots into its
	# real firmware it re-enumerates as 1d6b:8030 and the daemon talks to
	# it directly over USB, so the module is unloaded here -- matches
	# stock's own S99ar8030 sequence exactly.
	rmmod artosyn_drv
	usleep 100000

	mkdir -p "$RUNDIR"
	cd "$RUNDIR" || return 1
	start-stop-daemon -S -b -q -m -p /var/run/ar8030d.pid \
		-x /usr/bin/ar8030d -- -i 0 -l 2
	[ $? = 0 ] && echo "OK" || echo "FAIL"

	start_lifecycled
}

stop() {
	printf "Stopping ar8030... "
	start-stop-daemon -K -p /var/run/ar8030d.pid
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	[ -f "$LIFECYCLED_PIDFILE" ] && kill "$(cat "$LIFECYCLED_PIDFILE")" 2>/dev/null
	rm -f "$LIFECYCLED_PIDFILE"
}

case "$1" in
	start)
		start
		;;

	stop)
		stop
		;;

	restart)
		stop
		sleep 1
		start
		;;

	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
