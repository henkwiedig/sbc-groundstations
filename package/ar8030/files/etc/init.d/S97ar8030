#!/bin/sh
#
# Starts the Artosyn AR8030 baseband/RF link.
#

# Allow a few customizations from a config file
test -r /etc/default/ar8030 && . /etc/default/ar8030

BB_FW=${BB_FW:-ar8030/bb_demo_cx485_2PA.img}
BB_CFG=${BB_CFG:-ar8030/bb_config_gnd_pro.json}

if [ x$AR8030_ENABLED = x"false" ]; then
	echo "Starting ar8030... skipped (disabled)"
	exit 0
fi

# Power-on handshake for the AR8030 RF daughterboard, ported verbatim
# (GPIO numbers, ordering, delays) from stock's S99ar8030 enable_rf().
# Not modeled in the shared devicetree -- stock drives these as raw sysfs
# GPIOs too. gpio154=bank4/offset26, gpio83/84/82=bank2/offset19/20/18.
enable_rf() {
	echo 154 > /sys/class/gpio/export
	echo out > /sys/class/gpio/gpio154/direction
	echo 0 > /sys/class/gpio/gpio154/value

	echo 83 > /sys/class/gpio/export
	echo out > /sys/class/gpio/gpio83/direction
	echo 0 > /sys/class/gpio/gpio83/value

	echo 84 > /sys/class/gpio/export
	echo out > /sys/class/gpio/gpio84/direction
	echo 0 > /sys/class/gpio/gpio84/value

	echo 82 > /sys/class/gpio/export
	echo out > /sys/class/gpio/gpio82/direction
	echo 0 > /sys/class/gpio/gpio82/value

	usleep 100000

	echo 1 > /sys/class/gpio/gpio83/value
	echo 1 > /sys/class/gpio/gpio84/value

	usleep 50000

	echo 1 > /sys/class/gpio/gpio154/value

	usleep 50000

	echo 1 > /sys/class/gpio/gpio82/value

	usleep 280000

	echo in > /sys/class/gpio/gpio84/direction
	echo in > /sys/class/gpio/gpio83/direction
	echo in > /sys/class/gpio/gpio82/direction
}

# Waits (up to $2 seconds) for $1 to appear. Used the same way stock uses
# it: /dev/ar_mdev0 is artosyn_drv.ko's signal that firmware+config were
# successfully pushed to the chip over USB.
wait_flag_file() {
	flag_file="$1"
	max_timeout="$2"
	timeout_count=0

	while true; do
		[ -e "$flag_file" ] && return 0
		sleep 1
		timeout_count=$((timeout_count + 1))
		[ "$timeout_count" -ge "$max_timeout" ] && return 1
	done
}

start() {
	printf "Starting ar8030... "

	enable_rf

	modprobe artosyn_drv fw_name="$BB_FW" cfg_name="$BB_CFG"

	if ! wait_flag_file /dev/ar_mdev0 30; then
		echo "FAIL (firmware/config push timed out)"
		return 1
	fi

	# artosyn_drv.ko's only job is pushing firmware+config over USB while
	# the chip is in its boot-ROM stage (see /dev/ar_mdev0 above, used
	# purely as the "push done" signal). Once the chip reboots into its
	# real firmware it re-enumerates as 1d6b:8030 and the daemon talks to
	# it directly over USB, so the module is unloaded here -- matches
	# stock's own S99ar8030 sequence exactly.
	rmmod artosyn_drv
	usleep 100000

	start-stop-daemon -S -b -q -m -p /var/run/ar8030d.pid \
		-x /usr/bin/ar8030d -- -i 0 -l 2
	[ $? = 0 ] && echo "OK" || echo "FAIL"

	autoreconnect
}

# Bring the RF link back up after a normal reboot without needing
# ar8030-pair run by hand again. PRJ_CMD_EVENT_PAIR (see
# 0009-bb_pair-auto-reconnect-on-boot.patch) is the only mechanism that
# moves the chip from BB_LINK_STATE_IDLE to CONNECT -- a persisted
# ap_mac in $BB_CFG only tells the chip who it's *allowed* to link with,
# it does not make the chip attempt the link on its own at boot, so
# without this every reboot would otherwise need a manual re-pair
# (confirmed on real hardware).
#
# Gated on the "$BB_CFG.paired" marker, written only by a successful
# `ar8030-pair` run: a unit that has never been paired keeps the
# factory-default ap_mac/candidate pair (see the AP side's own "slot
# match all" help text for what an empty candidate list means) --
# looping this unconditionally would have a never-paired unit silently
# re-broadcast PRJ_CMD_EVENT_PAIR at whatever AR8030 happens to be in
# range. Runs detached so an air unit that isn't powered on yet doesn't
# delay boot; --skip-if-connected keeps it from re-triggering pairing
# against a link that's already up once it succeeds.
#
# restart funnels through start() again -- guard against piling up
# duplicate loops (stop() kills whatever this pidfile points at, if it
# still exists).
AUTORECONNECT_PIDFILE=/tmp/ar8030-autoreconnect.pid

# Keeps supervising after the link comes up, not just until the first
# success: ar8030-pair --skip-if-connected only ever confirmed the link
# WAS up at the moment it ran, and the RF link has been observed on real
# hardware to connect once after boot and then drop again on its own --
# a plain "retry until the first success" loop declares victory right
# before that drop and never notices, leaving the link down until a
# human re-runs ar8030-pair by hand. Poll BB_GET_STATUS ourselves in
# between attempts instead of just re-running ar8030-pair on a fixed
# timer, so a still-connected link doesn't get needlessly re-paired.
link_is_connected() {
	ar8030-linkctl status 2>/dev/null | grep -q ' CONNECT '
}

autoreconnect() {
	[ -x /usr/bin/ar8030-pair ] || return 0
	[ -f "/lib/firmware/$BB_CFG.paired" ] || return 0
	(
		while true; do
			while ! ar8030-pair --no-persist --skip-if-connected -c "/lib/firmware/$BB_CFG" \
					>>/tmp/ar8030-autoreconnect.log 2>&1; do
				sleep 10
			done

			# Now watch for a later drop instead of exiting -- re-enter the
			# pairing retry loop above if the link ever leaves CONNECT.
			while link_is_connected; do
				sleep 10
			done
			echo "link dropped, re-pairing" >>/tmp/ar8030-autoreconnect.log
		done
	) &
	echo $! > "$AUTORECONNECT_PIDFILE"
}

stop() {
	printf "Stopping ar8030... "
	start-stop-daemon -K -p /var/run/ar8030d.pid
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	[ -f "$AUTORECONNECT_PIDFILE" ] && kill "$(cat "$AUTORECONNECT_PIDFILE")" 2>/dev/null
	rm -f "$AUTORECONNECT_PIDFILE"
}

case "$1" in
	start)
		start
		;;

	stop)
		stop
		;;

	restart)
		stop
		sleep 1
		start
		;;

	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
