     bb_slot_e        slot_id = BB_SLOT_0;
     int              port_id = 2;
+    // On by default: needs 0008-session_socket-preserve-datagram-flag-on-open.patch
+    // on this end and the camera's (unpatched, upstream-hardcoded) netif on the
+    // other to actually agree -- see that patch and -g/--no-datagram below.
+    int  datagram_flg = 1;
     // tun field
     int  ipset_flg    = 0;
     int  mtu          = 1500;
--- a/dev_helper/tuntap_bb/test_bb_tun.cpp
+++ b/dev_helper/tuntap_bb/test_bb_tun.cpp
@@ -23,6 +23,7 @@
     printf(" -v --debug             debug mode in ethernet transfer\n");
     printf(" -r --rx_buf            buffer len of rx\n");
     printf(" -t --tx_buf            buffer len of tx\n");
+    printf(" -g --no-datagram       don't use BB_SOCK_FLAG_DATAGRAM (on by default)\n");

     return 0;
 }
@@ -134,7 +135,7 @@
     cfg.bb_fd = bb_socket_open(cfg.pdev,
                                cfg.slot_id,
                                cfg.port_id,
-                               BB_SOCK_FLAG_RX | BB_SOCK_FLAG_TX | BB_SOCK_FLAG_DATAGRAM,
