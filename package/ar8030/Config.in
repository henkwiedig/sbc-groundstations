config BR2_PACKAGE_AR8030
	bool "ar8030"
	select BR2_PACKAGE_LIBUSB
	help
	  Artosyn AR8030 baseband/RF-link host support for the Caddx VRX
	  Pro's internal USB-attached RF module — the vendor "yz_host_drv"
	  SDK (kernel driver + userspace RPC daemon + client library), same
	  source as the OpenIPC/builder air-side ar8030 package (pinned to
	  the same commit).

	  Always installed:
	  - artosyn_drv.ko: out-of-tree host driver. Only used transiently
	    at boot to push firmware+config into the AR8030 over USB while
	    it is in boot-ROM mode; the module is unloaded once the chip
	    re-enumerates with its real firmware running (unlike the air
	    side, where the chip is SDIO-attached and the driver stays
	    resident as the daemon's transport).
	  - ar8030d: the SDK "daemon". Owns the AR8030 once its real
	    firmware is running and talks to it directly over USB, and
	    serves the RPC that clients talk to (TCP on 127.0.0.1 plus a
	    unix socket).
	  - libar8030_client.so: the bb_* client API. Headers are installed
	    into <staging>/usr/include/ar8030.

	  Live link/data-channel quality is reported by ar8030-linkctl
	  status (package/ar8030-transport-rx), not by this package.

	  Includes the GPIO power-on sequence for the CX486-RF-2PA RF board
	  and the init script that brings the link up on boot.

	  Upstream calls the daemon and demo/debug tools "daemon", "app",
	  "ota", etc; they are installed with an ar8030 prefix here so they
	  can share /usr/bin with the rest of the rootfs.

	  The SDK is only published as source on a vendor Gitea instance
	  (no releases, no tags), so the package is pinned to a commit.

	  http://git.topxgun.com/czdu/yz_host_drv

if BR2_PACKAGE_AR8030

config BR2_PACKAGE_AR8030_FIRMWARE
	bool "install the CX486-RF-2PA baseband firmware"
	default y
	select BR2_PACKAGE_ASCENT_VENDOR_FIRMWARE
	help
	  Installs the RF daughterboard's baseband image and config to
	  /lib/firmware/ar8030 (bb_demo_cx485_2PA.img, bb_config_gnd_pro.json),
	  so the driver can push them into the chip via fw_name=/cfg_name=
	  module parameters. Override the filenames in /etc/default/ar8030
	  if a unit has a different RF board fitted.

	  bb_config_gnd_pro.json (plain baseband tuning config) is
	  committed. bb_demo_cx485_2PA.img is an unlicensed vendor binary
	  blob -- not committed -- so it's fetched fresh at build time
	  instead, from CADDX's own Ascent VRX Pro OTA image (see the
	  ascent-vendor-firmware package this selects). Best-effort: a
	  failed fetch just means the image ships without it, not a build
	  failure -- but unlike an AR8030 board that boots its RF chip from
	  its own flash, THIS board's S97ar8030 pushes bb_demo_cx485_2PA.img
	  over USB on every boot with no fallback, so a unit built without
	  it has no downlink at all until rebuilt with the file present.

config BR2_PACKAGE_AR8030_INIT
	bool "install /etc/init.d/S97ar8030"
	default y
	help
	  Boot script: runs the RF board's GPIO power-on sequence, loads
	  artosyn_drv (with fw_name/cfg_name) to push firmware over USB,
	  waits for /dev/ar_mdev0 (the driver's "push done" signal), unloads
	  the module, then starts ar8030d.

config BR2_PACKAGE_AR8030_PAIR_TOOL
	bool "bb_pair binding tool"
	default y
	select BR2_PACKAGE_CJSON
	help
	  Installs bb_pair as /usr/bin/ar8030-pair: the vendor's
	  pair/bind utility. Talks to ar8030d over the local RPC socket,
	  so the daemon has to be running.

	  On a successful pair, also writes the peer's MAC into the
	  on-disk baseband config (see 0005-*.patch) so it survives the
	  next reboot's firmware push, and S97ar8030 spawns a background
	  loop (see 0009-*.patch) that keeps reconnecting to it at every
	  boot -- so a paired unit no longer needs to be re-paired by
	  hand every time.

config BR2_PACKAGE_AR8030_USB_LOADER
	bool "USB rom-code firmware loader"
	default y
	help
	  Installs ar8030_usb_test_tool as /usr/bin/ar8030-usb-loader,
	  for USB-level diagnostics against an AR8030 sitting in USB
	  rom-code mode (VID:PID 4152:8030). Links against buildroot's own
	  libusb via pkg-config rather than the SDK's bundled/vendored copy
	  (see 0004-use-system-libusb-via-pkgconfig.patch).

config BR2_PACKAGE_AR8030_TOOLS
	bool "extra debug tools"
	default n
	help
	  Installs the SDK's demo and debug programs:
	    ar8030-cmd-dbg      interactive command console (cmd_dbg)
	    ar8030-ota          OTA image upgrade tool (ota)
	    ar8030-test         the generic API demo (app)
	    ar8030-netdev-demo  network-interface configuration demo

	  These are vendor test programs, not production tooling.

	  ar8030-netdev-demo will not work on this board: it opens
	  /dev/ar_net<N>, a char device the kernel driver only creates while
	  it is loaded -- and this package's own S97ar8030 rmmods the driver
	  right after the firmware push, once ar8030d takes over talking to
	  the chip directly over USB (see BR2_PACKAGE_AR8030_TUNTAP for the
	  transport-agnostic way to get an IP-routable interface over the
	  RF link instead).

config BR2_PACKAGE_AR8030_LIFECYCLED
	bool "lifecycle supervisor daemon"
	default n
	select BR2_PACKAGE_CJSON
	help
	  Installs ar8030-lifecycled: a dedicated process that owns the
	  AR8030 chip's whole lifecycle instead of leaving it to a pile of
	  independent shell-script watchdogs -- pulses the chip's hardware
	  reset line at startup, subscribes to the daemon's own link-state/
	  pair-result events (with a permanent BB_GET_STATUS fallback poll
	  as a safety net), triggers this project's pairing dispatch only
	  if this unit has never been paired before, and follows real link
	  state transitions. See dev_helper/ar8030-lifecycled/main.c for
	  its full set of CLI flags (reset backend/GPIO, hook directory,
	  baseband config path, default tuning) -- this board's own reset
	  line uses the gpio-sysfs backend (--reset-method gpio-sysfs,
	  --reset-gpio 154,83,84,82, matching S97ar8030's own enable_rf()),
	  not the devmem backend the air-side (SDIO) board uses.

	  Deliberately a separate process from ar8030d, not a thread
	  inside it -- confirmed live on the air-side board that running
	  this same logic as an in-daemon pthread wedged the daemon itself
	  under an SDIO transport fault; a genuinely separate process
	  talking to ar8030d over loopback, exactly like ar8030-linkctl/
	  ar8030-pair already do, does not share that risk.

	  Does not yet do tuning persistence (bandwidth/channel surviving
	  a reconnect) or hook-script dispatch on state transitions, and
	  is not yet wired into this package's own S97ar8030 init script
	  -- this board deliberately lags the air-side cutover by one
	  stage (see OpenIPC/builder's own ar8030-transport-tx package,
	  where it replaces S65's former autoreconnect/device_watchdog
	  logic already) so a role/interface/reset-backend difference
	  (DEV role, USB transport, gpio-sysfs reset vs. air's AP/SDIO/
	  devmem) gets its own dedicated verification pass before this
	  board's own boot sequence depends on it. Buildable today so
	  that pass can start without a separate patch round first.

config BR2_PACKAGE_AR8030_TUNTAP
	bool "TUN bridge over the RF link"
	default n
	help
	  Installs tuntap_bb as /usr/bin/ar8030-tun: bridges a normal Linux
	  TUN interface to a raw baseband socket (bb_socket_open/read/write
	  in libar8030_client, com/bb_api.h) opened over the RPC connection
	  to ar8030d -- unlike ar8030-netdev-demo (see BR2_PACKAGE_AR8030_TOOLS),
	  this only needs the daemon's RPC socket, not the kernel driver
	  itself, so it works with this board's rmmod-after-firmware-push
	  transport. Gives an IP-routable interface over the RF link once
	  both ends run a matching bridge at the same slot/port.

	  Needs CONFIG_TUN (modprobe tun first if it's built =m).

	  Links a vendored copy of libtuntap (dev_helper/tuntap_bb/
	  third_package/libtuntap.tar) -- there is no standalone Buildroot
	  package for it to use instead, unlike the libusb case
	  (0004-*.patch); see AR8030_INSTALL_TARGET_CMDS in ar8030.mk for
	  how its shared libs get shipped since this package's own
	  AR8030_INSTALL_TARGET_CMDS override skips CMake's install() step.

endif
