#!/bin/sh
# Reboot into the stock U-Boot (its USB download gadget, Ctrl-C on the serial
# console for a prompt). Stock's /etc/fb_reboot writes 0x3 to 0x0A106138
# ("reboot to uboot and use usb upgrade") before rebooting. The kernel's
# restart is a watchdog reset, which keeps the register.
devmem 0x0A106138 32 0x3 || exit 1
exec reboot
