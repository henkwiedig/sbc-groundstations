#!/bin/sh
# betafpv-vr04 /init (replaces board/common/overlay/init, which partitions a
# block device). The root is one of:
# - the initramfs: a RAM boot through the stock U-Boot (rdinit=/init), which
#   is writable already and touches no flash
# - the squashfs in the "rootfs" volume of the running slot's userapp, read
#   through a UBI block device (ubi.block=0,rootfs root=/dev/ubiblock0_0
#   init=/init, from the slot's dtb): the "rootfs_data" volume of the same
#   UBI device becomes the writable overlay. An empty one is formatted by its
#   first mount; tmpfs stands in if it does not mount.
# /overlay/.firstboot wipes the overlay, /overlay/.initshell stops in a shell.
# An update archive on the SD card is installed before the system starts.

on_exit() {
	mountpoint -q /proc && umount /proc
	exec /sbin/init "$@"
}

# The boot splash and backlight, in the background. Its modprobes may run
# after on_exit unmounted /proc, where they would not see a display blacklist
# on the command line (/etc/modprobe.d/vr04.conf), so that is checked here.
splash() {
	if ! grep -qE 'modprobe\.blacklist=[^ ]*(artosyn_vo|artosyn_dsi|panel_qy45043a0)' /proc/cmdline; then
		/usr/sbin/vr04-splash &
	fi
}

# The SD-card update (vr04-sdupdate), with a time limit: a hang there must not
# keep the goggles from booting.
sdupdate() {
	timeout -s KILL 900 /usr/sbin/vr04-sdupdate
	mountpoint -q /tmp/sdupdate && umount /tmp/sdupdate
	rm -rf /tmp/sdupdate.img
}

mount -t proc proc /proc || exec /sbin/init "$@"
trap 'on_exit "$@"' EXIT

mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
if [ "$(awk '$2 == "/" { t = $3 } END { print t }' /proc/mounts)" != squashfs ]; then
	# initramfs: the console as Buildroot's cpio /init sets it up
	exec 0</dev/console 1>/dev/console 2>/dev/console
	splash
	exit 0
fi

mount -t sysfs sys /sys
mount -t tmpfs tmpfs /tmp

if ! mount -t ubifs ubi0:rootfs_data /overlay; then
	echo "<1>init: no rootfs_data volume, changes are lost at power-off" > /dev/kmsg
	mount -t tmpfs tmpfs /overlay
fi

if [ -f /overlay/.initshell ]; then
	rm /overlay/.initshell
	/bin/sh
fi

if [ -f /overlay/.firstboot ]; then
	echo "<0>firstboot: wiping the overlay" > /dev/kmsg
	rm -rf /overlay/root /overlay/work /overlay/.firstboot
fi

mkdir -p /overlay/root /overlay/work
if ! mount -t overlay overlay -o lowerdir=/,upperdir=/overlay/root,workdir=/overlay/work /mnt; then
	umount /overlay
	exit 1
fi

/sbin/pivot_root /mnt /mnt/rom
mount -o noatime,move /rom/proc /proc
mount -o noatime,move /rom/sys /sys
mount -o noatime,move /rom/dev /dev
mount -o noatime,move /rom/overlay /overlay
mount -o noatime,move /rom/tmp /tmp

# The RNG gets the seed the last boot saved before anything reads
# /dev/urandom: until it is seeded, the kernel makes such a read wait for its
# jitter entropy, about 4 s on these cores, and automount, the first reader,
# held the boot up that long. S01seedrng runs again from rcS.
seedrng
splash
sdupdate
