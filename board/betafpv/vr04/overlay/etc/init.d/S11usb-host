#!/bin/sh
# USB-C port mode at boot: host for the external WiFi card(s) of wfb / apfpv
# and for USB audio (Audio on in the menu), gadget otherwise (see
# /usr/sbin/usb-host). Runs after udev (driver load, wlx naming) and before
# networking and wfb.

case "$1" in
start)
	usb-host auto 4
	;;
stop|restart|reload)
	;;
esac
