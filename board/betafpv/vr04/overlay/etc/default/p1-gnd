# The P1 ground unit this system runs on, for the scripts the P1 ground units
# share (board/betafpv/p1-gnd): gadget, vr04-splash, vr04-sdupdate, sysupgrade.

# USB product string of the RNDIS gadget
DEVICE_NAME="BetaFPV VR04"
# the product BetaFPV's 2.0.x images carry in their header (2.1.x: IGNORE)
STOCK_PRODUCT=P1_GND_VR04
# The display drivers, in load order: artosyn_gpio's hogs first (panel power
# and straps), the backlight's PWM, then the panel, DSI host and VO.
DISPLAY_MODULES="artosyn_gpio artosyn_pwm panel-qy45043a0 artosyn_dsi artosyn_vo"
# The panel's backlight: on once the splash is up, off at shutdown. Empty for
# a display without one (its framebuffer alone says it is up).
BACKLIGHT=/sys/class/backlight/backlight
