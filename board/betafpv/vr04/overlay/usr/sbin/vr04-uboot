#!/bin/sh
# Reboot into the stock U-Boot (its USB download gadget, Ctrl-C on the serial
# console for a prompt), as stock's fb_reboot does: the SPL starts U-Boot
# instead of the kernel when bit 0 of 0x0A106138 is set and the reset came
# from the watchdog.
v=$(devmem 0x0A106138 32) || exit 1
devmem 0x0A106138 32 $((v | 1))
sync
watchdog -T 1 -t 3600 /dev/watchdog
sleep 10
echo "vr04-uboot: no watchdog reset; power-cycle" >&2
exit 1
