#!/bin/sh
# SD-card update, from /init before the system starts (the other targets'
# /init does the same). In the root of the card, either
# - the release archive <BUILD_CONFIG>.tar.gz (the update image and its
#   md5sum, as published), or
# - an update image as BetaFPV names theirs, P1_GND_*.img: their stock
#   firmware (back to stock) or this build's P1_GND_*_OpenIPC_*.img
# goes into the slot that is not running -- sysupgrade carries this system's
# settings over to OpenIPC and makes that slot the active one -- and the
# goggles restart into it. Once installed the file is deleted; one that fails
# is renamed .failed, so it is not tried at every boot, and sysupgrade.log on
# the card says why (stock firmware with another SPL or vendor partition than
# this unit's goes in only through the stock U-Boot's USB upgrade). The panel
# shows it (update screens, busybox fbsplash's progress bar), and the buzzer:
# one beep when it starts, two when it is done, a long one when it failed. A
# power loss in between leaves the running slot the active one and the file
# on the card for the next boot.
#
# Stock firmware's own update menu installs an OpenIPC image too, and leaves
# it on the card. Stock also keeps .media_files.json there, an index of the
# card it writes whenever it has the card: with that index on the card the
# card comes straight from stock, the update is the one stock just installed,
# and it is renamed .skipped instead of installed a second time into the other
# slot. The index goes, either way, so that it cannot hold up a later update.

. /etc/os-release
ARCHIVE=$BUILD_CONFIG.tar.gz
SD=1c00000.mmc
MNT=/tmp/sdupdate
WORK=/tmp/sdupdate.img
LOG=$MNT/sysupgrade.log
STOCK_INDEX=$MNT/.media_files.json
BL=/sys/class/backlight/backlight
FIFO=/tmp/sdupdate.fifo
BAR=/tmp/sdupdate.bar
panel=

log() {
	echo "<5>sdupdate: $*" > /dev/kmsg
}

beep() {
	beep.sh "$1" > /dev/null 2>&1
}

# the card's disk, as mmcblkN
card() {
	local b
	for b in /sys/block/mmcblk*; do
		readlink -f "$b" | grep -q "/$SD/" && { echo "${b##*/}"; return 0; }
	done
	return 1
}

# what is there to install (names may have spaces: "P1_GND_... (1).img")
updates() {
	local f
	for f in "$MNT/$ARCHIVE" "$MNT"/P1_GND_*.img; do
		[ -f "$f" ] && echo "$f"
	done
}

# The panel: vr04-splash brings it up in the background and switches the
# backlight on last; up to 10 s for that, else the update goes without screens.
panel_up() {
	local i=0
	until [ "$(cat $BL/bl_power 2>/dev/null)" = 0 ]; do
		[ $i -ge 100 ] && return 1
		usleep 100000
		i=$((i + 1))
	done
}

# a full-screen picture: update, update-done, update-failed
screen() {
	[ -n "$panel" ] && fbv -c -u -i -y -f "/usr/share/$1.png" < /dev/null > /dev/null 2>&1
}

# The progress bar: fbsplash over the update screen, fed through a FIFO that
# this script holds open too, so that a write never blocks (also with fbsplash
# gone). Each stage of the update sets where the bar is and how far it may
# creep on (half a percent a second) until the next stage comes.
bar_start() {
	[ -n "$panel" ] || return 0
	mkfifo $FIFO && exec 3<> $FIFO || return 0
	fbsplash -s /usr/share/update-bar.ppm -i /usr/share/update-bar.ini -f $FIFO \
		< /dev/null > /dev/null 2>&1 &
	echo "0 0" > $BAR
	(
		shown=0
		while [ -f $BAR ]; do
			read -r at upto < $BAR
			[ "$shown" -lt "${at:-0}" ] && shown=$at
			[ "$shown" -lt "${upto:-0}" ] && shown=$((shown + 1))
			echo $shown >&3
			usleep 500000
		done
	) &
}

stage() {
	[ -n "$panel" ] && echo "$1 $2" > $BAR.new && mv $BAR.new $BAR
}

bar_stop() {
	[ -n "$panel" ] || return 0
	# a last round for the creeper to draw the last stage
	usleep 600000
	rm -f $BAR
	echo exit >&3
	exec 3>&-
	rm -f $FIFO
}

# the install's output: into the log on the card and the kernel log, and its
# stages onto the bar
follow() {
	local l
	while IFS= read -r l; do
		echo "$l" >> "$LOG"
		log "$l"
		case "$l" in
		*": OK") stage 30 34 ;;
		*" image, slot "*) stage 35 39 ;;
		*"writing kernel"*) stage 40 54 ;;
		*"writing dtb"*) stage 55 59 ;;
		*"writing userapp"*) stage 60 94 ;;
		*"settings carried over"*) stage 95 99 ;;
		esac
	done
}

# runs the install with its output followed; its exit status
run() {
	{
		"$@"
		echo $? > /tmp/sdupdate.rc
	} 2>&1 | follow
	[ "$(cat /tmp/sdupdate.rc 2>/dev/null)" = 0 ]
}

install_archive() {
	rm -rf $WORK && mkdir -p $WORK &&
		gzip -dc "$1" | tar -xf - -C $WORK && (cd $WORK && md5sum -c *.md5sum) &&
		sysupgrade --image="$(ls $WORK/*.img)"
}

failed() {
	updates | while IFS= read -r f; do
		mv "$f" "$f.failed"
	done
	umount $MNT
	log "failed: see sysupgrade.log on the card"
	bar_stop
	screen update-failed
	beep 1500
	# for reading the screen before the system takes the panel
	[ -n "$panel" ] && sleep 4
	exit 1
}

# artosyn_gpio's hogs power the card's I/O rail
modprobe artosyn_gpio && modprobe dw_mci-artosyn || exit 0
# The host's CDETECT register (DW MMC, 0x050), bit 0 high: no card in the
# slot, nothing to wait for. Read only with the driver bound (an unclocked
# read would stall the bus), after its 25 ms debounce.
[ -e /sys/bus/platform/drivers/dwmmc_artosyn/$SD ] || exit 0
usleep 50000
[ $(($(devmem 0x01c00050 32) & 1)) = 0 ] || exit 0

i=0
until disk=$(card); do
	[ $i -ge 15 ] && exit 0
	usleep 100000
	i=$((i + 1))
done
# its first partition (the partition scan can trail the disk), or the whole card
i=0
until [ -e /sys/block/$disk/${disk}p1 ] || [ $i -ge 5 ]; do
	usleep 100000
	i=$((i + 1))
done
dev=/dev/$disk
[ -e /sys/block/$disk/${disk}p1 ] && dev=/dev/${disk}p1

type=$(blkid "$dev" 2>/dev/null | sed -n 's/.* TYPE="\([^"]*\)".*/\1/p')
case "$type" in
vfat) modprobe vfat || exit 0 ;;
exfat) ;;
*) exit 0 ;;
esac
# read-only until there is something to do
mkdir -p $MNT && mount -t "$type" -o ro "$dev" $MNT || exit 0
file=$(updates | head -n 1)
if [ -z "$file" ]; then
	[ -f "$STOCK_INDEX" ] && mount -o remount,rw $MNT && rm -f "$STOCK_INDEX"
	umount $MNT
	exit 0
fi
mount -o remount,rw $MNT || { umount $MNT; exit 0; }

names=$(updates | sed 's|.*/||' | tr '\n' ' ')
if [ -f "$STOCK_INDEX" ]; then
	rm -f "$STOCK_INDEX"
	updates | while IFS= read -r f; do
		mv "$f" "$f.skipped"
	done
	echo "not installed: $names-- the card comes from stock firmware (its .media_files.json was on it), whose update menu installed it already; renamed .skipped (rename it back to install it)" > "$LOG"
	umount $MNT
	log "skipped (from stock firmware): $names"
	exit 0
fi

log "on the SD card: $names"
modprobe artosyn_pwm
beep 300
panel_up && panel=1
screen update
bar_start
stage 2 33
: > "$LOG"
if [ "$(updates | wc -l)" -gt 1 ]; then
	echo "more than one update on the card: $names-- keep one (all renamed .failed)" > "$LOG"
	failed
fi

case "$file" in
*.tar.gz)
	run install_archive "$file" || { rm -rf $WORK; failed; }
	rm -rf $WORK
	;;
*)
	run sysupgrade --image="$file" || failed
	;;
esac

rm -f "$file"
umount $MNT
log "installed: restarting into it"
stage 100 100
bar_stop
screen update-done
beep 150
usleep 150000
beep 150
# a watchdog reset, as vr04-uboot does
sync
watchdog -T 1 -t 3600 /dev/watchdog
sleep 10
log "no watchdog reset: power-cycle the goggles"
