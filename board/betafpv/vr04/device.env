# betafpv_vr04: the BetaFPV VR04 goggles, LCD on the MIPI-DSI output.
# Sourced by board/betafpv/p1-gnd/post-build.sh and post-image.sh, which get
# this directory from BR2_ROOTFS_POST_SCRIPT_ARGS.

# file names: ${DEVICE}-flash.dtb, ${DEVICE}-ram.dtb, ${DEVICE}-testboot/
DEVICE=vr04
# the kernel's device tree in images/ (ml-kernel's goggle DT)
DTB=proxima-9311.dtb
# the update image: <stock release>_OpenIPC${IMG_TAG}_<sha>.img
IMG_TAG=
# the display drivers, which the rootfs must have
DISPLAY_KMODS="artosyn_vo artosyn_dsi panel-qy45043a0"
