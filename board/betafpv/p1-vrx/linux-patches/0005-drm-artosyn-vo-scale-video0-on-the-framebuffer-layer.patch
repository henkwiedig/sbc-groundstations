diff --git a/drivers/gpu/drm/artosyn/artosyn_vo_coef.h b/drivers/gpu/drm/artosyn/artosyn_vo_coef.h
new file mode 100644
index 0000000..bd2ba6d
--- /dev/null
+++ b/drivers/gpu/drm/artosyn/artosyn_vo_coef.h
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * The DC framebuffer layer's filter tables, as stock computes them (libmpp, the helper of
+ * dc_set_zoom): 17 phases x 9 tap slots of Q14 weights, phase p at a sample offset of
+ * 0.5 - p/32 pixel from slot 4, a Lanczos-a kernel (a = taps / 2) over x = (k + offset)
+ * * min(1, dst/src), each phase normalised to 16384 with the truncation remainder on
+ * slot 4, packed two to a word (77 words). Integer: sin(pi x) by an odd Taylor
+ * polynomial on [0, 1/2] after range reduction, everything in Q30.
+ * Shared by the driver and a host test against stock's own tables (the includer defines
+ * AR_COEF_S64 and AR_COEF_U32).
+ */
+#define AR_COEF_PHASES	17
+#define AR_COEF_SLOTS	9
+#define AR_COEF_WORDS	77		/* 153 Q14 weights, two per word */
+#define AR_Q30		(1LL << 30)
+#define AR_PI_Q30	3373259426LL	/* pi * 2^30 */
+
+static AR_COEF_S64 ar_coef_mul(AR_COEF_S64 a, AR_COEF_S64 b)
+{
+	return (a * b) >> 30;
+}
+
+/* sin(pi x), x and result in Q30 */
+static AR_COEF_S64 ar_coef_sinpi(AR_COEF_S64 x)
+{
+	AR_COEF_S64 t, t2, s;
+	int neg = 0;
+
+	x %= 2 * AR_Q30;			/* sin(pi x) has period 2 */
+	if (x < 0)
+		x += 2 * AR_Q30;
+	if (x >= AR_Q30) {			/* sin(pi (x - 1)) = -sin(pi x) */
+		x -= AR_Q30;
+		neg = 1;
+	}
+	if (x > AR_Q30 / 2)			/* sin(pi x) = sin(pi (1 - x)) */
+		x = AR_Q30 - x;
+
+	t = ar_coef_mul(x, AR_PI_Q30);		/* 0 .. pi/2 */
+	t2 = ar_coef_mul(t, t);
+	s = AR_Q30 - t2 / 72;
+	s = AR_Q30 - ar_coef_mul(t2, s) / 42;
+	s = AR_Q30 - ar_coef_mul(t2, s) / 20;
+	s = AR_Q30 - ar_coef_mul(t2, s) / 6;
+	s = ar_coef_mul(t, s);
+	return neg ? -s : s;
+}
+
+/* sin(pi x) / (pi x), Q30; pi x from x >> 8 so that |x| up to 4.5 stays in 64 bits */
+static AR_COEF_S64 ar_coef_sinc(AR_COEF_S64 x)
+{
+	if (!x)
+		return AR_Q30;
+	return ar_coef_sinpi(x) * AR_Q30 / (((x >> 8) * AR_PI_Q30) >> 22);
+}
+
+/* Lanczos-a weight at x (Q30), Q30 */
+static AR_COEF_S64 ar_coef_lanczos(AR_COEF_S64 x, int a)
+{
+	AR_COEF_S64 ax = x < 0 ? -x : x;
+
+	if (ax >= (AR_COEF_S64)a * AR_Q30)
+		return 0;
+	return ar_coef_mul(ar_coef_sinc(x), ar_coef_sinc(x / a));
+}
+
+/* The table for taps (3, 5, 7, 9) and a dst/src ratio, as the 77 register words. */
+static void ar_coef_table(AR_COEF_U32 *words, int taps, unsigned int src, unsigned int dst)
+{
+	int a = taps / 2, p, k, i;
+	short w[AR_COEF_PHASES * AR_COEF_SLOTS + 1];
+
+	for (p = 0; p < AR_COEF_PHASES; p++) {
+		AR_COEF_S64 v[AR_COEF_SLOTS], sum = 0;
+		int q = 0;
+
+		for (k = -4; k <= 4; k++) {
+			/* x = (k + 1/2 - p/32), scaled by dst/src when shrinking */
+			AR_COEF_S64 x = ((AR_COEF_S64)(32 * k + 16 - p) * AR_Q30) / 32;
+
+			if (dst < src)
+				x = x * dst / src;
+			v[k + 4] = (k >= -a && k <= a) ? ar_coef_lanczos(x, a) : 0;
+			sum += v[k + 4];
+		}
+		for (i = 0; i < AR_COEF_SLOTS; i++) {
+			w[p * AR_COEF_SLOTS + i] = (short)(v[i] * 16384 / sum);
+			q += w[p * AR_COEF_SLOTS + i];
+		}
+		w[p * AR_COEF_SLOTS + 4] += 16384 - q;
+	}
+	w[AR_COEF_PHASES * AR_COEF_SLOTS] = 0;
+	for (i = 0; i < AR_COEF_WORDS; i++)
+		words[i] = (AR_COEF_U32)(unsigned short)w[2 * i] |
+			   (AR_COEF_U32)(unsigned short)w[2 * i + 1] << 16;
+}
