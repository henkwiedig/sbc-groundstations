 /*
  * Stock DSI-host register values for 1080p60, captured from the working (panel-lit) display and
  * diffed against the mainline dw-mipi-dsi config. The mainline programs several of these
@@ -97,11 +195,101 @@ static const struct { u16 off; u32 val; } ar_dsi_vid_1080p60[] = {
  */
 #define AR_DSI_MIPI_PLL_DIV	0x04a54972
 
+/*
+ * The MIPI TX PLL word for a lane rate: Q8.24 of 4000 / Mbps. Fits stock's capture above
+ * (861.02 Mbps -> 0x04a54974, two LSB off) and the 891 Mbps figure recovered from
+ * libmpp_service.so (0x047d453e).
+ */
+static u32 ar_dsi_pll_div(u32 lane_kbps)
+{
+	return (u32)DIV_ROUND_CLOSEST_ULL(4000000ULL << 24, lane_kbps);
+}
+
+/*
+ * Stock's DSI timing for a mode (dsi_set_timing with the bridge's attr): the line is the
+ * mode's htotal in lane byte clocks, rounded (2293 px at 24 bpp on 4 lanes -> 1720), the lane
+ * rate makes that line last exactly as long as the mode's (1720 * 8 * 154.7775 MHz / 2293 =
+ * 928.8 Mbps), and sync and back porch scale with it (59 -> 44, 197 -> 148). Vertical in
+ * lines. The same rule gives stock's nd043 panel numbers (1568 at 861.02 Mbps, 32/32).
+ */
+static void ar_dsi_mode_timing(struct ar_dsi *dsi, const struct drm_display_mode *m, int bpp)
+{
+	struct ar_dsi_timing *t = &dsi->t;
+	u32 ht = m->htotal;
+
+	t->hline = DIV_ROUND_CLOSEST(ht * bpp, 8 * dsi->lanes);
+	t->hsa = DIV_ROUND_CLOSEST((m->hsync_end - m->hsync_start) * t->hline, ht);
+	t->hbp = DIV_ROUND_CLOSEST((m->htotal - m->hsync_end) * t->hline, ht);
+	t->vsa = m->vsync_end - m->vsync_start;
+	t->vbp = m->vtotal - m->vsync_end;
+	t->vfp = m->vsync_start - m->vdisplay;
+	t->lane_kbps = (u32)DIV_ROUND_CLOSEST_ULL((u64)t->hline * 8 * m->clock, ht);
+}
+
+static_assert(ARRAY_SIZE(ar_dphy_offs) == ARRAY_SIZE(ar_dphy_sets[0].val));
+
+static const struct ar_dphy_set *ar_dsi_dphy_set(struct ar_dsi *dsi)
+{
+	unsigned int mbps = dsi->t.lane_kbps / 1000, i, best = 0;
+
+	for (i = 0; i < ARRAY_SIZE(ar_dphy_sets); i++) {
+		if (ar_dphy_sets[i].mbps == mbps)
+			return &ar_dphy_sets[i];
+		if (abs_diff(ar_dphy_sets[i].mbps, mbps) < abs_diff(ar_dphy_sets[best].mbps, mbps))
+			best = i;
+	}
+	dev_warn(dsi->dev, "no stock D-PHY set for %u Mbps, using the %u Mbps one\n",
+		 mbps, ar_dphy_sets[best].mbps);
+	return &ar_dphy_sets[best];
+}
+
+/* phy_init for artosyn,timing-from-mode: PLL and D-PHY for the mode's lane rate, the panel's
+ * proven host settings, the timing from the mode.
+ */
+static void ar_dsi_phy_init_mode(struct ar_dsi *dsi)
+{
+	const struct ar_dphy_set *set = ar_dsi_dphy_set(dsi);
+	const struct ar_dsi_timing *t = &dsi->t;
+	unsigned int i;
+
+	writel(ar_dsi_pll_div(t->lane_kbps), dsi->base + 0x2c0);
+
+	for (i = 0; i < ARRAY_SIZE(ar_dphy_offs); i++)
+		writel(set->val[i], dsi->base + ar_dphy_offs[i]);
+
+	for (i = 0; i < ARRAY_SIZE(ar_dsi_vid_1080p60); i++) {
+		u16 off = ar_dsi_vid_1080p60[i].off;
+		u32 val = ar_dsi_vid_1080p60[i].val;
+
+		if (off >= 0x48 && off <= 0x5c)	/* the panel's timing */
+			continue;
+		if (off == 0x08)
+			val = set->clkmgr;
+		writel(val, dsi->base + off);
+	}
+
+	writel(t->hsa, dsi->base + 0x48);
+	writel(t->hbp, dsi->base + 0x4c);
+	writel(t->hline, dsi->base + 0x50);
+	writel(t->vsa, dsi->base + 0x54);
+	writel(t->vbp, dsi->base + 0x58);
+	writel(t->vfp, dsi->base + 0x5c);
+
+	dev_info(dsi->dev, "%u.%03u Mbps/lane (PLL 0x%08x, D-PHY %u), line %u (hsa %u hbp %u), v %u/%u/%u\n",
+		 t->lane_kbps / 1000, t->lane_kbps % 1000, ar_dsi_pll_div(t->lane_kbps), set->mbps,
+		 t->hline, t->hsa, t->hbp, t->vsa, t->vbp, t->vfp);
+}
+
 static int ar_dsi_phy_init(void *priv)
 {
 	struct ar_dsi *dsi = priv;
 	unsigned int i;
 
+	if (dsi->timing_from_mode) {
+		ar_dsi_phy_init_mode(dsi);
+		goto lanes;
+	}
+
 	writel(AR_DSI_MIPI_PLL_DIV, dsi->base + 0x2c0);
 
 	for (i = 0; i < ARRAY_SIZE(ar_dphy_1080p60); i++)
@@ -110,6 +298,7 @@ static int ar_dsi_phy_init(void *priv)
 	for (i = 0; i < ARRAY_SIZE(ar_dsi_vid_1080p60); i++)
 		writel(ar_dsi_vid_1080p60[i].val, dsi->base + ar_dsi_vid_1080p60[i].off);
 
+lanes:
 	/* Lane count (PHY_IF_CFG = n_lanes - 1) and PHY reset deassert. */
 	writel(dsi->lanes - 1, dsi->base + DSI_PHY_IF_CFG);
 	writel(0xd, dsi->base + DSI_PHY_RSTZ);
@@ -122,10 +311,16 @@ static int ar_dsi_get_lane_mbps(void *priv, const struct drm_display_mode *mode,
 				unsigned long mode_flags, u32 lanes, u32 format,
 				unsigned int *lane_mbps)
 {
+	struct ar_dsi *dsi = priv;
 	int bpp = mipi_dsi_pixel_format_to_bpp(format);
 
 	if (bpp < 0)
 		bpp = 24;
+	if (dsi->timing_from_mode) {
+		ar_dsi_mode_timing(dsi, mode, bpp);
+		*lane_mbps = DIV_ROUND_UP(dsi->t.lane_kbps, 1000);
+		return 0;
+	}
 	/* per-lane bitrate = pixelclock * bpp / lanes (891 Mbps for 1080p60/24bpp/4). */
 	*lane_mbps = DIV_ROUND_UP(mode->clock * bpp, lanes * 1000);
 	return 0;
@@ -165,6 +360,7 @@ static int ar_dsi_probe(struct platform_device *pdev)
 
 	dsi->dev = dev;
 	dsi->lanes = 4;	/* TODO: read "dsi,lanes"/panel; RE confirms n_lanes-1 at 0xa4. */
+	dsi->timing_from_mode = of_property_read_bool(dev->of_node, "artosyn,timing-from-mode");
 	platform_set_drvdata(pdev, dsi);
 
 	/* Map the host window ourselves (no request) for the vendor PHY block; the
