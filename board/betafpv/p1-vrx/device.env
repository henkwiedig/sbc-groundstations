# betafpv_p1_vrx: the BetaFPV P1 HD VRX, HDMI out through a Lontium LT9611EX
# on the MIPI-DSI output. Sourced by board/betafpv/p1-gnd/post-build.sh and
# post-image.sh, which get this directory from BR2_ROOTFS_POST_SCRIPT_ARGS.

# file names: ${DEVICE}-flash.dtb, ${DEVICE}-ram.dtb, ${DEVICE}-testboot/
DEVICE=p1-vrx
# the kernel's device tree in images/ (dts/artosyn/proxima-9311-vrx.dts)
DTB=proxima-9311-vrx.dtb
# the update image: <stock release>_OpenIPC${IMG_TAG}_<sha>.img. The prefix
# stays BetaFPV's (P1_GND_v...), as the VR04's image that stock's update menu
# took; the tag tells the two apart (sysupgrade also checks the dtb's model).
IMG_TAG=-VRX
# the display drivers, which the rootfs must have
DISPLAY_KMODS="artosyn_vo artosyn_dsi lontium-lt9611ex"
