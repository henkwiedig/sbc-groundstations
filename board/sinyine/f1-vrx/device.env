# sinyine_f1_vrx: the SinYine F1 VRX (StartRC VT5 VRX board), HDMI out
# through an ITE IT66122 on the VO's parallel video port. Sourced by
# board/betafpv/p1-gnd/post-build.sh and post-image.sh (the P1 ground units'
# shared scripts), which get this directory from BR2_ROOTFS_POST_SCRIPT_ARGS.

# file names: ${DEVICE}-flash.dtb, ${DEVICE}-ram.dtb, ${DEVICE}-testboot/
DEVICE=sinyine-vrx
# the kernel's device tree in images/ (dts/artosyn/proxima-9311-sinyine-vrx.dts)
DTB=proxima-9311-sinyine-vrx.dtb
# the update image: ${IMG_NAME}_<sha>.${IMG_EXT}. The stock VRX installs
# what its card holds as SinYine_F1_VRX_<YYYYMMDD>_* (the newest date
# wins), through its upgrade menu; 99991231 is newer than any stock one.
IMG_NAME=SinYine_F1_VRX_99991231_OpenIPC
IMG_EXT=bin
# It is packed on BetaFPV's P1 GND image (its vendor, env and partition table
# are SinYine's byte for byte; its U-Boot is the same build but for one more
# NAND chip and the pin list), without BetaFPV's SPL: the stock upgrade menu
# and U-Boot's USB upgrade then leave the unit's own SPL in place, which sets
# this board's pins (the parallel video bus GPIO 45-64, the power hold 68,
# the fan 106, ...).
IMG_NO_LOADER=1
# the display drivers, which the rootfs must have
DISPLAY_KMODS="artosyn_vo display-connector ite-it66121"
