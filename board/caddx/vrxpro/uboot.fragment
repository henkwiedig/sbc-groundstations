CONFIG_CMD_SQUASHFS=y
CONFIG_ZSTD=y

# We're building on the generic evb-rk3568 reference target (no dedicated
# upstream board support for this hardware), whose default fdtfile points
# at its own reference dtb. Point it at our actual board's dtb instead, or
# extlinux's fdtdir auto-selection fails to find it and silently falls back
# to U-Boot's own embedded (wrong) devicetree.
CONFIG_DEFAULT_FDT_FILE="rockchip/rk3568-caddx-vrxpro.dtb"

# U-Boot's own internal devicetree (used for its own driver-model probing,
# e.g. regulator/PMIC init) was still the generic evb1-v10 reference board,
# separately from the kernel-facing fdtfile above -- that reference dtb has
# no regulator-init-microvolt values at all for our board's rails, unlike
# our real board's dtb (0002-add-rk3568-caddx-vrxpro-devicetree.patch adds
# it to the u-boot source tree).
CONFIG_DEFAULT_DEVICE_TREE="rockchip/rk3568-caddx-vrxpro"

# binman's FIT packaging step keeps its own separate list of fdt names to
# bundle, independent of CONFIG_DEFAULT_DEVICE_TREE above.
CONFIG_OF_LIST="rockchip/rk3568-caddx-vrxpro"

CONFIG_BAUDRATE=115200

# Early boot splash on HDMI, same as the Radxa Zero 3 boards: the VOP2 +
# RK3568 HDMI series (0004-0015, see uboot-patches/README.md) gives U-Boot a
# framebuffer, and PREBOOT shows /usr/share/splash*.bmp from the squashfs
# rootfs. uboot-menu.env's GPIO boot menu stays inert here: there is no
# uboot-buttons.env (the VRX Pro's buttons are an ADC ladder, not GPIOs).
CONFIG_BOOTDELAY=1
CONFIG_VIDEO=y
CONFIG_DISPLAY=y
CONFIG_VIDEO_ROCKCHIP=y
CONFIG_DISPLAY_ROCKCHIP_HDMI=y
CONFIG_VIDEO_REMOVE=y
CONFIG_BMP=y
CONFIG_CMD_BMP=y
CONFIG_CMD_CLS=y
CONFIG_BMP_24BPP=y
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="for d in 0 1; do if sqfsload mmc ${d}:1 ${loadaddr} /usr/share/splash-bg.bmp; then bmp display ${loadaddr} m m; fi; if sqfsload mmc ${d}:1 ${loadaddr} /usr/share/splash.bmp; then bmp display ${loadaddr} m m; fi; done; setenv stdout serial; setenv stderr serial; for f in /boot/uboot-menu.env /boot/uboot-buttons.env; do if sqfsload mmc 1:1 ${loadaddr} $f || sqfsload mmc 0:1 ${loadaddr} $f; then env import -t ${loadaddr} ${filesize}; fi; done; if env exists preboot_hook; then run preboot_hook; fi"
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
CONFIG_CONSOLE_MUX=y

# Boot menu on the VRX Pro button ladder: uboot-buttons.env reads SARADC
# channel 6 with `adc single` (see board/caddx/vrxpro/overlay/boot).
CONFIG_CMD_ADC=y

# Stock firmware from the internal SPI NAND (boot menu): read-only access to
# the SFC flash. U-Boot keeps the SPI NAND bad-block table in RAM only
# (nanddev_bbt_update() is a no-op), so nothing here writes to the NAND.
CONFIG_ROCKCHIP_SFC=y
CONFIG_DM_MTD=y
CONFIG_MTD_SPI_NAND=y
CONFIG_CMD_MTD=y
CONFIG_CMD_SETEXPR=y
