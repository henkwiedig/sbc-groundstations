+/*
+ * MPP_CMD_STREAM_APPEND. Busy, late or lost, the outcome is in result: the
+ * ioctl fails only on memory it cannot read or write. An error would leave
+ * the request's msgs behind in mpp_collect_msgs() and two lines on the
+ * console, and tell the client no more than result does.
+ */
+static int rkvdec2_strm_append(struct mpp_session *session, struct mpp_request *req)
+{
+	struct mpp_dev *mpp = session->mpp;
+	struct rkvdec2_dev *dec = to_rkvdec2_dev(mpp);
+	struct rkvdec2_session_priv *priv = session->priv;
+	struct mpp_stream_append a;
+	struct rkvdec2_strm_chunk c;
+	struct rkvdec2_task *task;
+	unsigned long flags;
+
+	size_t len = min_t(size_t, req->size, sizeof(a));
+
+	/* time_us, the last field, only MPP_STREAM_WAIT needs */
+	memset(&a, 0, sizeof(a));
+	if (len < offsetof(struct mpp_stream_append, time_us) ||
+	    copy_from_user(&a, req->data, len))
+		return -EFAULT;
+
+	if ((a.flags & MPP_STREAM_WAIT) && priv && rkvdec2_strm_capable(mpp)) {
+		u32 seq;
+
+		spin_lock_irqsave(&dec->strm_lock, flags);
+		seq = priv->strm_seq;
+		spin_unlock_irqrestore(&dec->strm_lock, flags);
+		/* a signal ends the wait as its timeout does */
+		(void)wait_event_interruptible_timeout(dec->strm_wq,
+				READ_ONCE(priv->strm_paused_seq) == seq ||
+				(s32)(READ_ONCE(priv->strm_done_seq) - seq) >= 0 ||
+				READ_ONCE(priv->strm_seq) != seq,
+				msecs_to_jiffies(min_t(u32, a.length, 1000)));
+		spin_lock_irqsave(&dec->strm_lock, flags);
+		if (priv->strm_paused_seq == seq) {
+			a.result = MPP_STREAM_PAUSED;
+			a.time_us = priv->strm_pause_us;
+		} else if ((s32)(priv->strm_done_seq - seq) >= 0 || priv->strm_seq != seq) {
+			a.result = MPP_STREAM_DONE;
+		} else {
+			a.result = MPP_STREAM_TIMEOUT;
+		}
+		spin_unlock_irqrestore(&dec->strm_lock, flags);
+		goto out;
+	}
+
+	if (a.flags & MPP_STREAM_PROBE) {
+		a.result = rkvdec2_strm_capable(mpp) ? MPP_STREAM_SUPPORTED : MPP_STREAM_NO_PICTURE;
+		a.length = MPP_STREAM_CAP_WAIT;
+		goto out;
+	}
+	a.result = MPP_STREAM_NO_PICTURE;
+	if (!rkvdec2_strm_capable(mpp) || !priv)
+		goto out;
+
+	spin_lock_irqsave(&dec->strm_lock, flags);
+	task = priv->strm_task;
+	if (!task || task->strm_closed)
+		goto unlock;
+	if (!a.length) {
+		/* nothing to add: only an end means anything */
+		if (a.flags & MPP_STREAM_LAST)
+			rkvdec2_strm_cut(mpp, task);
+		a.result = MPP_STREAM_TAKEN;
+		goto unlock;
+	}
+	if (a.offset < task->strm_buf_len && a.length <= task->strm_buf_len - a.offset) {
+		c.addr = task->strm_buf + a.offset;
+		c.len = a.length;
+		c.last = !!(a.flags & MPP_STREAM_LAST);
+		if (rkvdec2_strm_give(mpp, task, &c)) {
+			a.result = MPP_STREAM_TAKEN;
+			goto unlock;
+		}
+	}
+	/*
+	 * Outside its buffer, or no room in its queue: the picture cannot have
+	 * this part, nor any after it. It ends where its data ends, and the
+	 * client hears NO_PICTURE, as for a picture ended already - not left
+	 * open, waiting for a part that is not coming.
+	 */
+	rkvdec2_strm_cut(mpp, task);
+unlock:
+	spin_unlock_irqrestore(&dec->strm_lock, flags);
+out:
+	if (copy_to_user(req->data, &a, len))
+		return -EFAULT;
+	return 0;
+}
