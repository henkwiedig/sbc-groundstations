+++ b/board/rockchip/evb_rk3568/evb-rk3568.c
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+/*
+ * The generic evb-rk3568 boot_mode.c reads the download key from an ADC
+ * channel wired as a resistor-divider button on the Rockchip EVB reference
+ * board. The Caddx VRX Pro doesn't have that button wired the same way, so
+ * the floating/unconnected channel reads a spuriously low value on every
+ * boot and forces an unwanted reset into Maskrom download mode. Override
+ * the weak default to disable that check.
+ */
+int rockchip_dnl_key_pressed(void)
+{
+	return 0;
+}
