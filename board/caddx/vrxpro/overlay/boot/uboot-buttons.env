# Caddx VRX Pro buttons for the U-Boot boot menu (see /boot/uboot-menu.env).
# The 5-way joystick is one resistor ladder on SARADC channel 6, read in uV:
# up 800 mV, right 1200, center 1400, down 1600 (+-80 mV, the windows stock
# and PixelPilot's adc_input.cpp use). Hold UP at power-on for the menu;
# RIGHT or center (OK) boots the selected entry.
btn_up=adc
btn_read=setenv gup 0; setenv gdn 0; setenv gok 0; adc single saradc@fe720000 6 bv; if test $bv -gt 720000 && test $bv -lt 880000; then setenv gup 1; fi; if test $bv -gt 1520000 && test $bv -lt 1680000; then setenv gdn 1; fi; if test $bv -gt 1120000 && test $bv -lt 1480000; then setenv gok 1; fi
#
# "Stock firmware (NAND)" boot menu entry: the stock system still lives on the
# internal HYF2GQ4UAACAE SPI NAND (mtdparts from stock's parameter.txt, in
# bytes). Its boot partition holds a Rockchip FIT whose load addresses are
# vendor placeholders, so bootm can't take it: unpack the LZ4 kernel and the
# DT by their data-position and booti them with stock's own command line.
# Read-only on the NAND -- U-Boot keeps its bad-block table in RAM.
stock_fit=0x14000000
stock_args=earlycon=uart8250,mmio32,0xfe660000 console=ttyFIQ0 ubi.mtd=5 root=ubi0:rootfs rootfstype=ubifs mtdparts=spi-nand0:0x800000@0x400000(uboot),0x200000@0xc00000(misc),0x1000000@0xe00000(factory),0x1800000@0x1e00000(boot),0x2400000@0x3600000(recovery),-@0x5a00000(rootfs)
bootstock=mtd read spi-nand0 ${stock_fit} 0x1e00000 0x1800000 && fdt addr ${stock_fit} && fdt get value kpos /images/kernel data-position && fdt get value dpos /images/fdt data-position && fdt get value dsz /images/fdt data-size && setexpr ksrc ${stock_fit} + ${kpos} && setexpr dsrc ${stock_fit} + ${dpos} && unlz4 ${ksrc} ${kernel_addr_r} 0x6000000 && cp.b ${dsrc} ${fdt_addr_r} ${dsz} && setenv bootargs ${stock_args} && booti ${kernel_addr_r} - ${fdt_addr_r}
