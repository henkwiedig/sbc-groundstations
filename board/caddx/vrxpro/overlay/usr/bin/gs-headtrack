#!/usr/bin/env python3
"""
gs-headtrack -- head tracking backend for the Caddx VRX Pro.

Reads the goggles' own motion sensors, fuses them into a head attitude and
publishes it to the outputs asked for (none by default):
  --target HOST:PORT  MAVLink ATTITUDE + RAW_IMU (sysid 250 / compid 25 by
                      default); PixelPilot's MAVLink input is 127.0.0.1:14550,
                      where it shows up as mavlink.attitude.* facts
  --gimbal HOST:PORT  gimbal head tracking frames (below)
/etc/init.d/S99headtrack runs it with --gimbal and ar8030-xdata relay when
head tracking is enabled (off by default; PixelPilot: System -> Head tracking).

Hardware (found on the board; stock reads it the same way from user space):
  - IMU: TDK ICM-40609-D (WHO_AM_I 0x3B, ICM-426xx register map) on SPI0,
    stock dts name "mpu6509"; driven through spidev (spi0.0).
  - Magnetometer: QST QMC5883P (chip id 0x80) on I2C bus 5, address 0x2c.
    Published raw in MAVLink RAW_IMU (xmag/ymag/zmag, with the raw IMU
    counts); not fused yet -- yaw is gyro-only, so it can drift; the bias
    tracking below keeps that small (0.2 deg in 200 s at rest on the bench).

Stock never gets this to an output on the VRX Pro: its fused angles go over
the Artosyn link on xdata sub-channel 1, which the air firmware drops.

--gimbal HOST:PORT also sends the head attitude as Walksnail / Caddx GM
gimbal head tracking frames (the format iNAV's serial gimbal and ArduPilot's
CADDX mount driver use), one UDP datagram per frame:

  A5 5A | mode:3 sens:5 | reserved:4 roll:12 tilt:12 pan:12 (LSB first) | CRC16 BE

angles as 12-bit two's complement, 4096 per turn; CRC-16/CCITT (poly 0x1021,
init 0) over the first 8 bytes. `ar8030-xdata relay` (ar8030-transport) on
127.0.0.1:5770 takes these datagrams to the air unit's chip UART2, which on
the Caddx Ascent Lite+ is the gimbal UART. The angles are relative to the
attitude when the calibration ends; SIGUSR1 re-centres (S99headtrack recentre,
PixelPilot's BACK button with the menu closed).

The roll/pitch/yaw names in --gimbal-map are the IMU's own angles, as --debug
prints them. The IMU sits on its side in the VRX Pro (about 100 deg roll at
rest), so nodding shows up as IMU roll and head roll as IMU pitch. The default
map, pan=yaw,tilt=-roll,roll=-pitch, was confirmed on a Caddx GM gimbal
(GimbalConfig V3.8) on 2026-11-08.

The mode field picks one of the gimbal's three mode slots, M0..M2, as they are
set up in GimbalConfig (defaults M0 FPVM-ANGL, M1 PLCK-ANGL, M2 HORI-ANGL);
head tracking wants the FPV slot. Other values are undefined and make the GM
jump. GimbalConfig talks to the same gimbal input: stop this stream while it
is connected, or parameter saves fail ("Serial Port Transmit Error").

Gyro bias: at start-up it waits until the goggles hold still for 1.5 s
(a start from the menu comes with button presses) and only then sends; after
that it keeps refining the bias whenever they rest, which also takes out the
slow drift as the goggles warm up.
"""

import argparse
import array
import collections
import fcntl
import math
import os
import signal
import socket
import struct
import sys
import time

SPI_DEV = "/sys/bus/spi/devices/spi0.0"

# --- ICM-40609-D over spidev -------------------------------------------------

SPI_IOC_WR_MODE = 0x40016B01
SPI_IOC_MESSAGE_1 = 0x40206B00
REG_DEVICE_CONFIG, REG_ACCEL_DATA, REG_PWR_MGMT0 = 0x11, 0x1F, 0x4E
REG_GYRO_CONFIG0, REG_ACCEL_CONFIG0, REG_WHO_AM_I, REG_BANK_SEL = 0x4F, 0x50, 0x75, 0x76
GYRO_LSB_PER_DPS = 65.5      # GYRO_CONFIG0 FS code 010: +-500 dps
ACCEL_LSB_PER_G = 4096.0     # ACCEL_CONFIG0 FS code 010: +-8 g on the ICM-40609-D


def bind_spidev():
    """Hand spi0.0 to spidev (there is no kernel driver for this IMU)."""
    if not os.path.exists("/dev/spidev0.0"):
        with open(SPI_DEV + "/driver_override", "w") as f:
            f.write("spidev")
        try:
            with open("/sys/bus/spi/drivers/spidev/bind", "w") as f:
                f.write("spi0.0")
        except OSError:
            pass
        for _ in range(50):
            if os.path.exists("/dev/spidev0.0"):
                break
            time.sleep(0.02)


class Imu:
    def __init__(self):
        bind_spidev()
        self.fd = os.open("/dev/spidev0.0", os.O_RDWR)
        fcntl.ioctl(self.fd, SPI_IOC_WR_MODE, struct.pack("B", 3))

    def _xfer(self, tx):
        txb = array.array("B", tx)
        rxb = array.array("B", bytes(len(tx)))
        tr = struct.pack("QQIIHBBBBBB", txb.buffer_info()[0], rxb.buffer_info()[0], len(tx),
                         8000000, 0, 8, 0, 0, 0, 0, 0)
        fcntl.ioctl(self.fd, SPI_IOC_MESSAGE_1, tr)
        return rxb.tobytes()

    def rd(self, reg, n=1):
        return self._xfer([0x80 | reg] + [0] * n)[1:]

    def wr(self, reg, val):
        self._xfer([reg & 0x7F, val])

    def start(self):
        self.wr(REG_BANK_SEL, 0)
        self.wr(REG_DEVICE_CONFIG, 0x01)          # soft reset
        time.sleep(0.01)
        who = self.rd(REG_WHO_AM_I)[0]
        if who != 0x3B:
            sys.exit("gs-headtrack: unexpected IMU WHO_AM_I 0x%02x (want 0x3b)" % who)
        self.wr(REG_GYRO_CONFIG0, 0x48)           # +-500 dps, ODR 100 Hz
        self.wr(REG_ACCEL_CONFIG0, 0x48)          # +-8 g, ODR 100 Hz
        self.wr(REG_PWR_MGMT0, 0x0F)              # gyro + accel low-noise
        time.sleep(0.1)

    def read(self):
        """(ax, ay, az) in g, (gx, gy, gz) in rad/s; raw counts in self.raw."""
        v = struct.unpack(">6h", self.rd(REG_ACCEL_DATA, 12))
        self.raw = v
        a = tuple(x / ACCEL_LSB_PER_G for x in v[:3])
        g = tuple(math.radians(x / GYRO_LSB_PER_DPS) for x in v[3:])
        return a, g

    def stop(self):
        self.wr(REG_PWR_MGMT0, 0x00)


# --- QMC5883P over /dev/i2c-5 --------------------------------------------------

class Mag:
    def __init__(self, bus=5, addr=0x2C):
        self.fd = os.open("/dev/i2c-%d" % bus, os.O_RDWR)
        fcntl.ioctl(self.fd, 0x0703, addr)        # I2C_SLAVE
        os.write(self.fd, bytes([0x0A, 0xCD]))     # stock's control 1 value
        os.write(self.fd, bytes([0x0B, 0x00]))     # stock's control 2 value

    def read(self):
        os.write(self.fd, bytes([0x01]))
        return struct.unpack("<3h", os.read(self.fd, 6))


# --- Madgwick 6-axis filter -----------------------------------------------------

class Madgwick:
    def __init__(self, beta=0.05):
        self.q = [1.0, 0.0, 0.0, 0.0]
        self.beta = beta

    def seed(self, ax, ay, az):
        """Start at the attitude gravity implies (yaw 0) instead of level."""
        roll = math.atan2(ay, az)
        pitch = math.atan2(-ax, math.sqrt(ay * ay + az * az))
        cr, sr = math.cos(roll / 2), math.sin(roll / 2)
        cp, sp = math.cos(pitch / 2), math.sin(pitch / 2)
        self.q = [cr * cp, sr * cp, cr * sp, -sr * sp]

    def update(self, g, a, dt):
        q0, q1, q2, q3 = self.q
        gx, gy, gz = g
        ax, ay, az = a
        qd0 = 0.5 * (-q1 * gx - q2 * gy - q3 * gz)
        qd1 = 0.5 * (q0 * gx + q2 * gz - q3 * gy)
        qd2 = 0.5 * (q0 * gy - q1 * gz + q3 * gx)
        qd3 = 0.5 * (q0 * gz + q1 * gy - q2 * gx)
        n = math.sqrt(ax * ax + ay * ay + az * az)
        if n > 0.0:
            ax, ay, az = ax / n, ay / n, az / n
            f0 = 2 * (q1 * q3 - q0 * q2) - ax
            f1 = 2 * (q0 * q1 + q2 * q3) - ay
            f2 = 2 * (0.5 - q1 * q1 - q2 * q2) - az
            s0 = -2 * q2 * f0 + 2 * q1 * f1
            s1 = 2 * q3 * f0 + 2 * q0 * f1 - 4 * q1 * f2
            s2 = -2 * q0 * f0 + 2 * q3 * f1 - 4 * q2 * f2
            s3 = 2 * q1 * f0 + 2 * q2 * f1
            sn = math.sqrt(s0 * s0 + s1 * s1 + s2 * s2 + s3 * s3)
            if sn > 0.0:
                qd0 -= self.beta * s0 / sn
                qd1 -= self.beta * s1 / sn
                qd2 -= self.beta * s2 / sn
                qd3 -= self.beta * s3 / sn
        q0 += qd0 * dt
        q1 += qd1 * dt
        q2 += qd2 * dt
        q3 += qd3 * dt
        n = math.sqrt(q0 * q0 + q1 * q1 + q2 * q2 + q3 * q3)
        self.q = [q0 / n, q1 / n, q2 / n, q3 / n]

    def euler(self):
        q0, q1, q2, q3 = self.q
        roll = math.atan2(2 * (q0 * q1 + q2 * q3), 1 - 2 * (q1 * q1 + q2 * q2))
        pitch = math.asin(max(-1.0, min(1.0, 2 * (q0 * q2 - q3 * q1))))
        yaw = math.atan2(2 * (q0 * q3 + q1 * q2), 1 - 2 * (q2 * q2 + q3 * q3))
        return roll, pitch, yaw


# --- MAVLink v1 ATTITUDE ----------------------------------------------------------

def x25(data, crc=0xFFFF):
    for b in data:
        t = b ^ (crc & 0xFF)
        t = (t ^ (t << 4)) & 0xFF
        crc = ((crc >> 8) ^ (t << 8) ^ (t << 3) ^ (t >> 4)) & 0xFFFF
    return crc


class MavlinkOut:
    MSG_ATTITUDE, CRC_EXTRA_ATTITUDE = 30, 39
    MSG_RAW_IMU, CRC_EXTRA_RAW_IMU = 27, 144

    def __init__(self, target, sysid, compid):
        host, port = target.rsplit(":", 1)
        self.addr = (host, int(port))
        self.sysid, self.compid, self.seq = sysid, compid, 0
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

    def _send(self, msgid, crc_extra, payload):
        hdr = bytes([len(payload), self.seq, self.sysid, self.compid, msgid])
        crc = x25(hdr + payload)
        crc = x25(bytes([crc_extra]), crc)
        self.sock.sendto(b"\xfe" + hdr + payload + struct.pack("<H", crc), self.addr)
        self.seq = (self.seq + 1) & 0xFF

    def attitude(self, t_ms, rpy, rates):
        """ATTITUDE: radians, rad/s."""
        self._send(self.MSG_ATTITUDE, self.CRC_EXTRA_ATTITUDE,
                   struct.pack("<I6f", t_ms & 0xFFFFFFFF, *rpy, *rates))

    def raw_imu(self, t_us, acc, gyr, mag):
        """RAW_IMU: raw sensor counts (v1 payload, no id/temperature extensions)."""
        self._send(self.MSG_RAW_IMU, self.CRC_EXTRA_RAW_IMU,
                   struct.pack("<Q9h", t_us & 0xFFFFFFFFFFFFFFFF, *acc, *gyr, *mag))


# --- Walksnail / Caddx GM gimbal head tracking frame ---------------------------------

def crc16_ccitt(data, crc=0):
    for b in data:
        crc ^= b << 8
        for _ in range(8):
            crc = ((crc << 1) ^ 0x1021) & 0xFFFF if crc & 0x8000 else (crc << 1) & 0xFFFF
    return crc


def gimbal_frame(pan_deg, tilt_deg, roll_deg, mode=0, sens=0):
    """10-byte head tracking frame; angles in degrees, clamped to +-180."""
    def a12(deg):
        v = int(round(max(-180.0, min(180.0, deg)) * 2048.0 / 180.0))
        return max(-2048, min(2047, v)) & 0xFFF
    angles = (a12(roll_deg) << 4) | (a12(tilt_deg) << 16) | (a12(pan_deg) << 28)
    body = bytes([0xA5, 0x5A, (mode & 0x07) | ((sens & 0x1F) << 3)]) + angles.to_bytes(5, "little")
    crc = crc16_ccitt(body)
    return body + bytes([crc >> 8, crc & 0xFF])


class GimbalOut:
    AXES = ("roll", "pitch", "yaw")

    def __init__(self, target, mode, sens, mapping):
        host, port = target.rsplit(":", 1)
        self.addr = (host, int(port))
        self.mode, self.sens = mode, sens
        self.map = self._parse_map(mapping)
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

    @classmethod
    def _parse_map(cls, spec):
        """'pan=yaw,tilt=pitch,roll=roll': gimbal axis = [-]head axis, or 0 (centred)."""
        out = {"pan": (None, 1), "tilt": (None, 1), "roll": (None, 1)}
        for item in spec.split(","):
            key, _, src = item.strip().partition("=")
            sign = -1 if src.startswith("-") else 1
            src = src.lstrip("+-")
            if key not in out or (src != "0" and src not in cls.AXES):
                sys.exit("gs-headtrack: bad --gimbal-map entry %r" % item)
            out[key] = (None if src == "0" else cls.AXES.index(src), sign)
        return out

    def angles(self, rpy_deg):
        def pick(axis):
            idx, sign = self.map[axis]
            return 0.0 if idx is None else sign * rpy_deg[idx]
        return pick("pan"), pick("tilt"), pick("roll")

    def send(self, rpy_deg):
        pan, tilt, roll = self.angles(rpy_deg)
        self.sock.sendto(gimbal_frame(pan, tilt, roll, self.mode, self.sens), self.addr)
        return pan, tilt, roll


def wrap180(deg):
    return (deg + 180.0) % 360.0 - 180.0


# --- gyro bias --------------------------------------------------------------------

IMU_HZ = 100
STILL_SPREAD = math.radians(3.0)   # max-min of each gyro axis over a window = still
                                   # (at rest, fan on: median 1.0, max 1.9 deg/s)
CAL_WINDOW_S = 1.5                 # start-up: still this long, then bias = its mean
CAL_TIMEOUT_S = 10.0               # never still: the quietest window seen
TRACK_WINDOW_S = 1.0               # running: bias follows still windows...
TRACK_TAU_S = 10.0                 # ...this slowly...
TRACK_STEP_S = 0.5                 # (one look per this)
TRACK_MAX = math.radians(2.0)      # ...if within this of the bias (else it's a slow turn)


class GyroWindow:
    """The last n (gyro, accel) samples."""

    def __init__(self, seconds):
        self.buf = collections.deque(maxlen=int(seconds * IMU_HZ))

    def add(self, g, a):
        self.buf.append((g, a))

    def full(self):
        return len(self.buf) == self.buf.maxlen

    def spread(self):
        return max(max(s[0][i] for s in self.buf) - min(s[0][i] for s in self.buf) for i in range(3))

    def mean(self, k):
        """k 0: gyro, 1: accel"""
        return [sum(s[k][i] for s in self.buf) / len(self.buf) for i in range(3)]


def calibrate(imu):
    """(gyro bias, mean accel, gyro spread, still) from the first still window."""
    win = GyroWindow(CAL_WINDOW_S)
    best = None
    t_end = time.monotonic() + CAL_TIMEOUT_S
    while True:
        a, g = imu.read()
        win.add(g, a)
        if win.full():
            spread = win.spread()
            if best is None or spread < best[2]:
                best = (win.mean(0), win.mean(1), spread)
            if spread <= STILL_SPREAD or time.monotonic() >= t_end:
                return best + (spread <= STILL_SPREAD,)
        time.sleep(1.0 / IMU_HZ)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--target", metavar="HOST:PORT",
                    help="send MAVLink ATTITUDE/RAW_IMU to this UDP target, e.g. 127.0.0.1:14550 "
                         "(PixelPilot); default: no MAVLink")
    ap.add_argument("--sysid", type=int, default=250)
    ap.add_argument("--compid", type=int, default=25)
    ap.add_argument("--rate", type=float, default=50.0, help="MAVLink messages per second")
    ap.add_argument("--raw-rate", type=float, default=10.0,
                    help="RAW_IMU (raw IMU + magnetometer) messages per second, 0 = off")
    ap.add_argument("--gimbal", metavar="HOST:PORT",
                    help="also send gimbal head tracking frames (A5 5A ...) as UDP datagrams, "
                         "e.g. 127.0.0.1:5770 for ar8030-xdata relay")
    ap.add_argument("--gimbal-rate", type=float, default=50.0, help="gimbal frames per second")
    ap.add_argument("--gimbal-mode", type=int, default=0, choices=(0, 1, 2),
                    help="gimbal mode slot M0..M2 as set up in GimbalConfig "
                         "(default slots: 0 FPV = head tracking, 1 pitch lock, 2 horizon)")
    ap.add_argument("--gimbal-sens", type=int, default=0, help="frame stabilisation sensitivity, -16..15")
    ap.add_argument("--gimbal-map", default="pan=yaw,tilt=-roll,roll=-pitch",
                    help="gimbal axis = [-]roll|pitch|yaw of the IMU (as --debug prints them), "
                         "or 0 to hold it centred; the default fits the VRX Pro's IMU mounting")
    ap.add_argument("--debug", action="store_true", help="print angles and raw magnetometer")
    args = ap.parse_args()
    # SIGTERM (S99headtrack stop) ends it like ^C: through the finally below.
    # SIGUSR1 re-centres; caught from the start, as its default would kill it.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    recentre = [False]
    signal.signal(signal.SIGUSR1, lambda *_: recentre.__setitem__(0, True))
    if not -16 <= args.gimbal_sens <= 15:
        sys.exit("gs-headtrack: --gimbal-sens must be -16..15")
    gimbal = GimbalOut(args.gimbal, args.gimbal_mode, args.gimbal_sens, args.gimbal_map) if args.gimbal else None

    imu = Imu()
    imu.start()
    try:
        mag = Mag()
    except OSError as e:
        mag = None
        print("gs-headtrack: magnetometer unavailable (%s)" % e, file=sys.stderr)
    out = MavlinkOut(args.target, args.sysid, args.compid) if args.target else None
    if not out and not gimbal and not args.debug:
        sys.exit("gs-headtrack: no output; give --target, --gimbal and/or --debug")
    filt = Madgwick()
    try:
        run(args, imu, mag, out, gimbal, filt, recentre)
    except KeyboardInterrupt:
        pass
    finally:
        imu.stop()


def run(args, imu, mag, out, gimbal, filt, recentre):
    # gyro bias from a still moment; seed the filter with gravity
    bias, acc, spread, still = calibrate(imu)
    filt.seed(*acc)
    print("gs-headtrack: gyro bias %.2f %.2f %.2f deg/s (spread %.1f deg/s%s)" %
          (*(math.degrees(b) for b in bias), math.degrees(spread), "" if still else ", never still"),
          file=sys.stderr, flush=True)
    if out:
        print("gs-headtrack: MAVLink to %s as %d/%d" % (args.target, args.sysid, args.compid), file=sys.stderr)

    # gimbal angles are relative to this attitude; SIGUSR1 takes a new one
    centre = tuple(math.degrees(v) for v in filt.euler())
    recentre[0] = False
    if gimbal:
        print("gs-headtrack: gimbal frames to %s:%d at %.0f Hz, mode %d, sens %d, map %s" %
              (*gimbal.addr, args.gimbal_rate, args.gimbal_mode, args.gimbal_sens, args.gimbal_map),
              file=sys.stderr, flush=True)

    t0 = time.monotonic()
    last = t0
    next_send = t0
    next_raw = t0
    next_gimbal = t0
    next_dbg = t0
    next_track = t0
    track = GyroWindow(TRACK_WINDOW_S)
    mag_raw = (0, 0, 0)
    gim = (0.0, 0.0, 0.0)
    period = 1.0 / IMU_HZ
    while True:
        now = time.monotonic()
        a, g_raw = imu.read()
        # bias tracking: a still window whose mean is near the bias is the bias
        track.add(g_raw, a)
        if now >= next_track and track.full():
            next_track = now + TRACK_STEP_S
            if track.spread() <= STILL_SPREAD:
                m = track.mean(0)
                if all(abs(x - b) <= TRACK_MAX for x, b in zip(m, bias)):
                    k = TRACK_STEP_S / TRACK_TAU_S
                    bias = [b + k * (x - b) for x, b in zip(m, bias)]
        g = tuple(x - b for x, b in zip(g_raw, bias))
        filt.update(g, a, now - last)
        last = now
        if out and now >= next_send:
            next_send += 1.0 / args.rate
            out.attitude(int((now - t0) * 1000), filt.euler(), g)
        if args.raw_rate > 0 and now >= next_raw:
            next_raw += 1.0 / args.raw_rate
            if mag:
                mag_raw = mag.read()
            if out:
                out.raw_imu(int((now - t0) * 1e6), imu.raw[:3], imu.raw[3:], mag_raw)
        if recentre[0]:
            recentre[0] = False
            centre = tuple(math.degrees(v) for v in filt.euler())
            print("gs-headtrack: re-centred (gyro bias %.2f %.2f %.2f deg/s)" %
                  tuple(math.degrees(b) for b in bias), file=sys.stderr, flush=True)
        if gimbal and now >= next_gimbal:
            next_gimbal = max(next_gimbal + 1.0 / args.gimbal_rate, now - 0.1)
            rel = tuple(wrap180(math.degrees(v) - c) for v, c in zip(filt.euler(), centre))
            try:
                gim = gimbal.send(rel)
            except OSError:
                pass
        if args.debug and now >= next_dbg:
            next_dbg += 0.5
            r, p, y = (math.degrees(v) for v in filt.euler())
            print("roll %7.1f pitch %7.1f yaw %7.1f  bias %5.2f %5.2f %5.2f  mag %s" %
                  (r, p, y, *(math.degrees(b) for b in bias), mag_raw) +
                  ("  gimbal pan %6.1f tilt %6.1f roll %6.1f" % gim if gimbal else ""), flush=True)
        time.sleep(max(0.0, period - (time.monotonic() - now)))


if __name__ == "__main__":
    main()
