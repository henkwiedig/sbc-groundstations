 		dclk_rate = dclk->rate;
 	else
 		dclk_rate = adjusted_mode->crtc_clock * 1000 / vp->dclk_div;
+	/*
+	 * Start every modeset from the nominal refresh rate: the clk core skips
+	 * an unchanged rate, which would keep a trim from vsync_adjust.
