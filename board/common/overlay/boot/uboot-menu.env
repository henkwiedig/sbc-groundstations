# U-Boot GPIO boot menu (generic logic, all boards).
# Imported by CONFIG_PREBOOT together with the per-board /boot/uboot-buttons.env,
# which defines btn_up / btn_dn / btn_ok (U-Boot pin names, e.g. d9 = gpiochip3 line 9).
# Without a buttons file the preboot_hook does nothing.
# btn_read sets gup/gdn/gok to 1 while a button is held; this default reads
# the GPIOs, a board with other buttons overrides it in its buttons file
# (e.g. the Caddx VRX Pro's ADC ladder) and still sets btn_up as a marker.
btn_read=gpio read gup $btn_up; gpio read gdn $btn_dn; gpio read gok $btn_ok
# UP/DOWN step through the entries (edge-triggered, so a held button moves
# once); a third "Stock firmware" entry appears when the board file
# defines bootstock (the Caddx VRX Pro: stock firmware from SPI NAND).
# Plain-text env format: one variable per line (no line continuation).
menu_draw=setenv stdout serial,vidconsole; cls; echo; echo "  ===== BOOT MENU ====="; if test "$msel" = "0"; then echo "  ==> Normal boot"; else echo "      Normal boot"; fi; if test "$msel" = "1"; then echo "  ==> Verbose boot"; else echo "      Verbose boot"; fi; if env exists bootstock; then if test "$msel" = "2"; then echo "  ==> Stock firmware (NAND)"; else echo "      Stock firmware (NAND)"; fi; fi; echo "  UP/DOWN select - RIGHT boot"; setenv stdout serial
bootmenu_gpio=setenv msel 0; setenv mlast x; setenv mdone 0; setenv pup 1; setenv pdn 0; setenv stdout serial; while test "$mdone" = "0"; do if test "$msel" != "$mlast"; then setenv mlast $msel; run menu_draw; fi; run btn_read; if test "$gup" = "1" && test "$pup" != "1"; then if test "$msel" = "2"; then setenv msel 1; else setenv msel 0; fi; fi; if test "$gdn" = "1" && test "$pdn" != "1"; then if test "$msel" = "0"; then setenv msel 1; elif test "$msel" = "1" && env exists bootstock; then setenv msel 2; fi; fi; setenv pup $gup; setenv pdn $gdn; if test "$gok" = "1"; then setenv mdone 1; fi; sleep 0.1; done; setenv stdout serial,vidconsole; if test "$msel" = "2"; then echo "Booting stock firmware ..."; run bootstock; echo "Stock boot failed, booting normal ..."; elif test "$msel" = "1"; then echo "Booting VERBOSE ..."; setenv pxe_label_override verbose; else echo "Booting normal ..."; fi; setenv mdone; setenv mlast; setenv gup; setenv gdn; setenv gok; setenv pup; setenv pdn
preboot_hook=if env exists btn_up; then run btn_read; if test x$gup = x1; then setenv stdout serial,vidconsole; setenv stderr serial,vidconsole; run bootmenu_gpio; fi; fi
